{%- doc -%}
  Renders a header menu block with desktop hover submenus.
  Mobile menu remains unchanged.
  Modified to show collection submenus with images.
  Added smooth hover animations.

  @param {string} [variant] - What version of the menu to render. Defaults to header menu.
  @param {string} [transparent] - Show a transparent menu
{%- enddoc -%}

{% liquid
  assign animation_speed = 200

  if block.settings.menu_style == 'featured_products' and block.settings.product_title_case == 'uppercase'
    assign title_case_style = ' --title-case: uppercase;'
  elsif block.settings.menu_style == 'featured_collections' and block.settings.collection_title_case == 'uppercase'
    assign title_case_style = ' --title-case: uppercase;'
  elsif block.settings.menu_style == 'collection_images' and block.settings.collection_title_case == 'uppercase'
    assign title_case_style = ' --title-case: uppercase;'
  endif
  
  comment
    Mobile collections custom styling
  endcomment
  assign mobile_text_size = block.settings.mobile_collection_text_size | default: '0.875rem'
  assign mobile_text_color = block.settings.mobile_collection_text_color
%}

{% case variant %}
  {% when 'mobile' %}
    <div
      class="header__drawer desktop:hidden"
      ref="headerDrawerContainer"
      style="{{ title_case_style }}"
      {{ block.shopify_attributes }}
    >
      {% render 'header-drawer',
        class: 'header__drawer--mobile',
        linklist: block.settings.menu,
        data_header_drawer_type: 'mobile-drawer'
      %}
      
      {%- comment -%} Mobile Custom Collections Section {%- endcomment -%}
      {% assign has_mobile_collections = false %}
      {% if block.settings.mobile_collection_1 != blank or block.settings.mobile_collection_2 != blank or block.settings.mobile_collection_3 != blank or block.settings.mobile_collection_4 != blank or block.settings.mobile_collection_5 != blank or block.settings.mobile_collection_6 != blank %}
        {% assign has_mobile_collections = true %}
      {% endif %}
      
      {% if has_mobile_collections %}
        <div class="mobile-collections-wrapper" style="{% if mobile_text_color != blank %}--mobile-collection-text-color: {{ mobile_text_color }};{% endif %} --mobile-collection-text-size: {{ mobile_text_size }};">
          <div class="mobile-collections mobile-collections--{{ block.settings.mobile_collections_layout }}">
            {% if block.settings.mobile_collection_1 != blank %}
              <a href="{{ block.settings.mobile_collection_1.url }}" class="mobile-collection-item">
                {% if block.settings.mobile_collections_layout != 'text' %}
                  <div class="mobile-collection-item__image-wrapper">
                    {% if block.settings.mobile_collection_1.image != blank %}
                      <img
                        src="{{ block.settings.mobile_collection_1.image | image_url: width: 400 }}"
                        alt="{{ block.settings.mobile_collection_1.title | escape }}"
                        class="mobile-collection-item__image"
                        loading="lazy"
                      />
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'mobile-collection-item__image placeholder-svg' }}
                    {% endif %}
                  </div>
                {% endif %}
                <h3 class="mobile-collection-item__title">{{ block.settings.mobile_collection_1.title }}</h3>
              </a>
            {% endif %}
            
            {% if block.settings.mobile_collection_2 != blank %}
              <a href="{{ block.settings.mobile_collection_2.url }}" class="mobile-collection-item">
                {% if block.settings.mobile_collections_layout != 'text' %}
                  <div class="mobile-collection-item__image-wrapper">
                    {% if block.settings.mobile_collection_2.image != blank %}
                      <img
                        src="{{ block.settings.mobile_collection_2.image | image_url: width: 400 }}"
                        alt="{{ block.settings.mobile_collection_2.title | escape }}"
                        class="mobile-collection-item__image"
                        loading="lazy"
                      />
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'mobile-collection-item__image placeholder-svg' }}
                    {% endif %}
                  </div>
                {% endif %}
                <h3 class="mobile-collection-item__title">{{ block.settings.mobile_collection_2.title }}</h3>
              </a>
            {% endif %}
            
            {% if block.settings.mobile_collection_3 != blank %}
              <a href="{{ block.settings.mobile_collection_3.url }}" class="mobile-collection-item">
                {% if block.settings.mobile_collections_layout != 'text' %}
                  <div class="mobile-collection-item__image-wrapper">
                    {% if block.settings.mobile_collection_3.image != blank %}
                      <img
                        src="{{ block.settings.mobile_collection_3.image | image_url: width: 400 }}"
                        alt="{{ block.settings.mobile_collection_3.title | escape }}"
                        class="mobile-collection-item__image"
                        loading="lazy"
                      />
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'mobile-collection-item__image placeholder-svg' }}
                    {% endif %}
                  </div>
                {% endif %}
                <h3 class="mobile-collection-item__title">{{ block.settings.mobile_collection_3.title }}</h3>
              </a>
            {% endif %}
            
            {% if block.settings.mobile_collection_4 != blank %}
              <a href="{{ block.settings.mobile_collection_4.url }}" class="mobile-collection-item">
                {% if block.settings.mobile_collections_layout != 'text' %}
                  <div class="mobile-collection-item__image-wrapper">
                    {% if block.settings.mobile_collection_4.image != blank %}
                      <img
                        src="{{ block.settings.mobile_collection_4.image | image_url: width: 400 }}"
                        alt="{{ block.settings.mobile_collection_4.title | escape }}"
                        class="mobile-collection-item__image"
                        loading="lazy"
                      />
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'mobile-collection-item__image placeholder-svg' }}
                    {% endif %}
                  </div>
                {% endif %}
                <h3 class="mobile-collection-item__title">{{ block.settings.mobile_collection_4.title }}</h3>
              </a>
            {% endif %}
            
            {% if block.settings.mobile_collection_5 != blank %}
              <a href="{{ block.settings.mobile_collection_5.url }}" class="mobile-collection-item">
                {% if block.settings.mobile_collections_layout != 'text' %}
                  <div class="mobile-collection-item__image-wrapper">
                    {% if block.settings.mobile_collection_5.image != blank %}
                      <img
                        src="{{ block.settings.mobile_collection_5.image | image_url: width: 400 }}"
                        alt="{{ block.settings.mobile_collection_5.title | escape }}"
                        class="mobile-collection-item__image"
                        loading="lazy"
                      />
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'mobile-collection-item__image placeholder-svg' }}
                    {% endif %}
                  </div>
                {% endif %}
                <h3 class="mobile-collection-item__title">{{ block.settings.mobile_collection_5.title }}</h3>
              </a>
            {% endif %}
            
            {% if block.settings.mobile_collection_6 != blank %}
              <a href="{{ block.settings.mobile_collection_6.url }}" class="mobile-collection-item">
                {% if block.settings.mobile_collections_layout != 'text' %}
                  <div class="mobile-collection-item__image-wrapper">
                    {% if block.settings.mobile_collection_6.image != blank %}
                      <img
                        src="{{ block.settings.mobile_collection_6.image | image_url: width: 400 }}"
                        alt="{{ block.settings.mobile_collection_6.title | escape }}"
                        class="mobile-collection-item__image"
                        loading="lazy"
                      />
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'mobile-collection-item__image placeholder-svg' }}
                    {% endif %}
                  </div>
                {% endif %}
                <h3 class="mobile-collection-item__title">{{ block.settings.mobile_collection_6.title }}</h3>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

  {% when 'navigation_bar' %}
    {% if block.settings.navigation_bar == true %}
      <div
        class="menu-list menu-list--mobile{% if transparent == blank %} color-{{ block.settings.color_scheme_navigation_bar }}{% endif %}"
        style="--menu-horizontal-gap: 15px; --mobile-nav-margin: auto;{{ title_case_style }}"
      >
        <div class="menu-list__scroll-container">
          <ul
            class="menu-list__list list-unstyled"
            role="list"
          >
            {%- comment -%} Manual Links - Add your custom links here {%- endcomment -%}
            {% if block.settings.manual_link_1_text != blank %}
              <li>
                <a
                  href="{{ block.settings.manual_link_1_url }}"
                  class="menu-list__item"
                >
                  {{- block.settings.manual_link_1_text -}}
                </a>
              </li>
            {% endif %}

            {% if block.settings.manual_link_2_text != blank %}
              <li>
                <a
                  href="{{ block.settings.manual_link_2_url }}"
                  class="menu-list__item"
                >
                  {{- block.settings.manual_link_2_text -}}
                </a>
              </li>
            {% endif %}

            {% if block.settings.manual_link_3_text != blank %}
              <li>
                <a
                  href="{{ block.settings.manual_link_3_url }}"
                  class="menu-list__item"
                >
                  {{- block.settings.manual_link_3_text -}}
                </a>
              </li>
            {% endif %}

            {% if block.settings.manual_link_4_text != blank %}
              <li>
                <a
                  href="{{ block.settings.manual_link_4_url }}"
                  class="menu-list__item"
                >
                  {{- block.settings.manual_link_4_text -}}
                </a>
              </li>
            {% endif %}

            {% if block.settings.manual_link_5_text != blank %}
              <li>
                <a
                  href="{{ block.settings.manual_link_5_url }}"
                  class="menu-list__item"
                >
                  {{- block.settings.manual_link_5_text -}}
                </a>
              </li>
            {% endif %}

            {% if block.settings.manual_link_6_text != blank %}
              <li>
                <a
                  href="{{ block.settings.manual_link_6_url }}"
                  class="menu-list__item"
                >
                  {{- block.settings.manual_link_6_text -}}
                </a>
              </li>
            {% endif %}

            {%- comment -%} Original Menu Links (if you want to keep them) {%- endcomment -%}
            {% if block.settings.show_menu_links %}
              {% for link in block.settings.menu.links %}
                <li>
                  <a
                    href="{{ link.url }}"
                    id="MenuItem-{{ link.handle }}"
                    class="menu-list__item"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title -}}
                  </a>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% else %}
    <header-menu
      ref="headerMenu"
      class="header-menu mobile:hidden"
      data-animation-delay="{{ animation_speed }}"
      {{ block.shopify_attributes }}
      style="--submenu-animation-speed: {{ animation_speed }}ms;{{ title_case_style }}"
    >
      <div class="header-menu__inner">
        {%- render 'header-menu-with-collections' %}
      </div>

      <script
        src="{{ 'header-menu.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
    </header-menu>
{% endcase %}

{% stylesheet %}
  .menu-list--mobile {
    &.menu-list {
      display: grid;
    }

    & .menu-list__list {
      width: max-content;
      margin-inline: auto;
      gap: var(--menu-horizontal-gap);
    }

    & li {
      width: max-content;
      padding-block: var(--padding-sm);
    }

    & li:first-of-type {
      padding-inline-start: var(--menu-horizontal-gap);
    }

    & li:last-of-type {
      padding-inline-end: var(--menu-horizontal-gap);
    }

    & a {
      color: var(--color-foreground);
    }
  }

  .menu-list__scroll-container {
    position: relative;
    overflow-x: auto;
    mask-image: linear-gradient(to right, transparent, black 20px, black calc(100% - 20px), transparent);
    padding-block: var(--padding-2xs);
  }

  header-menu {
    width: 100%;
  }

  /* ============================================
     MOBILE COLLECTIONS SECTION - FULL WIDTH HORIZONTAL SCROLL
     ============================================ */
  .mobile-collections-wrapper {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 0;
    background-color: var(--color-background);
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.1);
    overflow: hidden;
  }

  .mobile-collections {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    scroll-behavior: smooth;
    width: 100%;
  }

  .mobile-collections::-webkit-scrollbar {
    display: none; /* Chrome, Safari */
  }

  .mobile-collections--grid {
    flex-direction: row;
    padding: 0;
  }

  .mobile-collections--list {
    flex-direction: column;
    padding: var(--padding-md);
    gap: var(--padding-sm);
  }

  .mobile-collections--text {
    flex-direction: row;
    padding: 0;
  }

  /* Grid Layout - Horizontal Scroll with Images */
  .mobile-collections--grid .mobile-collection-item {
    flex: 0 0 auto;
    width: 120px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    padding: var(--padding-md) var(--padding-sm);
    text-align: center;
    cursor: pointer;
  }

  .mobile-collections--grid .mobile-collection-item:first-child {
    padding-left: var(--padding-md);
  }

  .mobile-collections--grid .mobile-collection-item:last-child {
    padding-right: var(--padding-md);
  }

  /* Text Only Layout - Full Width Scroll */
  .mobile-collections--text {
    border-bottom: 2px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .mobile-collections--text .mobile-collection-item {
    flex: 0 0 auto;
    text-decoration: none;
    display: flex;
    align-items: center;
    padding: var(--padding-md) var(--padding-lg);
    white-space: nowrap;
    position: relative;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .mobile-collections--text .mobile-collection-item:first-child {
    padding-left: var(--padding-md);
  }

  .mobile-collections--text .mobile-collection-item:last-child {
    padding-right: var(--padding-md);
  }

  .mobile-collections--text .mobile-collection-item::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-foreground);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .mobile-collections--text .mobile-collection-item:active::after {
    transform: scaleX(1);
  }

  /* List Layout - Vertical with Side Images - Not scrollable */
  .mobile-collections--list {
    flex-direction: column;
    overflow-x: visible;
    padding: var(--padding-md);
  }

  .mobile-collections--list .mobile-collection-item {
    flex-direction: row;
    align-items: center;
    gap: var(--padding-md);
    text-decoration: none;
    display: flex;
    padding: var(--padding-sm) 0;
    cursor: pointer;
    width: 100%;
  }

  .mobile-collection-item:active {
    opacity: 0.7;
  }

  .mobile-collection-item__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .mobile-collections--grid .mobile-collection-item__image-wrapper {
    aspect-ratio: 1 / 1;
    width: 100%;
    margin-bottom: var(--padding-xs);
  }

  .mobile-collections--list .mobile-collection-item__image-wrapper {
    aspect-ratio: 1 / 1;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .mobile-collection-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .mobile-collection-item:active .mobile-collection-item__image {
    transform: scale(1.05);
  }

  .mobile-collection-item__title {
    font-family: var(--menu-child-font-family);
    font-size: var(--mobile-collection-text-size, var(--font-size--sm));
    font-weight: 600;
    color: var(--mobile-collection-text-color, var(--menu-child-font-color));
    margin: 0;
    transition: color 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .mobile-collections--grid .mobile-collection-item__title {
    text-align: center;
    font-size: var(--mobile-collection-text-size, 0.75rem);
    line-height: 1.2;
  }

  .mobile-collections--list .mobile-collection-item__title {
    text-align: left;
    flex: 1;
    font-size: var(--mobile-collection-text-size, 0.875rem);
  }

  .mobile-collections--text .mobile-collection-item__title {
    font-size: var(--mobile-collection-text-size, 0.875rem);
    font-weight: 500;
  }

  .mobile-collection-item:active .mobile-collection-item__title {
    color: var(--menu-child-active-font-color);
  }

  /* Drawer menu featured content */
  .menu-drawer__featured-content {
    z-index: var(--layer-lowest);
    container-type: inline-size;
  }

  .menu-drawer__featured-content--childlist {
    z-index: var(--layer-flat);
  }

  .menu-drawer__featured-content-list {
    display: flex;
    gap: 1em;
    overflow-x: auto;
    padding-block-end: var(--padding-lg);
  }

  .menu-drawer__featured-content-list-item {
    flex: 0 0 auto;
  }

  .menu-drawer__featured-content-list-item--product {
    width: 35cqi;
  }

  .menu-drawer__featured-content-list-item--collection img.resource-card__image {
    width: 80cqi;
  }

  .menu-drawer__featured-content-list-item:first-child {
    margin-inline-start: var(--margin-xl);
  }

  .menu-drawer__featured-content-list-item:last-child {
    margin-inline-end: var(--margin-xl);
  }

  /* Apply title case to drawer menu featured content */
  .menu-drawer__featured-content-list-item--product .resource-card__title,
  .menu-drawer__featured-content-list-item--collection .resource-card__title {
    text-transform: var(--title-case);
  }

  .menu-list {
    --menu-horizontal-gap: 1.5rem;
    --menu-vertical-gap: var(--gap-xl);

    display: flex;
  }

  @media screen and (min-width: 990px) {
    .menu-list {
      --menu-horizontal-gap: 2rem;
    }
  }

  @media screen and (min-width: 1200px) {
    .menu-list {
      --menu-horizontal-gap: 2.5rem;
    }
  }

  @media screen and (min-width: 1400px) {
    .menu-list {
      --menu-horizontal-gap: 3rem;
    }
  }

  .menu-list__list {
    display: flex;
    justify-content: var(--grid-area-alignment);
    gap: var(--menu-horizontal-gap);
  }

  .menu-list__list-item {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .menu-list__list-item[aria-hidden='true'] {
    visibility: hidden;
  }

  /* ============================================
     IMPROVED HOVER ANIMATIONS FOR MENU LINKS
     ============================================ */
  .menu-list__link {
    font-family: var(--menu-top-level-font-family);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    font-size: var(--menu-top-level-font-size);
    line-height: var(--menu-top-level-font-line-height);
    text-transform: var(--menu-top-level-font-case);
    color: var(--menu-top-level-font-color);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: flex;
    min-height: var(--minimum-touch-target);
    align-items: center;
    position: relative;

    /* Animated underline effect */
    &::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 50%;
      width: 0;
      height: 2px;
      background-color: currentColor;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateX(-50%);
    }

    &:hover,
    &:focus {
      color: var(--menu-top-level-font-color);
      transform: translateY(-2px);
    }

    &:hover::after,
    &:focus::after {
      width: 100%;
    }

    @media screen and (min-width: 750px) {
      font-size: var(--menu-top-level-font-size-desktop);
    }
  }

  /*
      High specificity selectors to subdue non-hovered links without javascript.
      If the need for js-generated `hovered` and `focused` classes arises for another reason we can simplify these.
    */
  .menu-list:where(:has(.menu-list__list-item:hover)),
  .menu-list:where(:has(.menu-list__list-item:focus-within)),
  .menu-list:where(:has(.menu-list__list-item:not([aria-hidden='true']) .menu-list__link--active)) {
    .menu-list__link {
      color: rgb(var(--menu-top-level-font-color-rgb) / var(--opacity-subdued-text));
      transform: scale(0.98);
    }
  }

  /* stylelint-disable-next-line selector-max-specificity */
  .menu-list:not(:has(.menu-list__list-item:hover)) .menu-list__link--active,
  .menu-list .menu-list__list-item:where(:hover, :focus-within) .menu-list__link,
  .menu-list .menu-list__list-item[slot='overflow'] .menu-list__link[aria-expanded='true'] {
    color: var(--menu-top-level-font-color);
    transform: scale(1);
  }

  .overflow-menu::part(list) {
    /* Make sure focus outline is not cut off by overflow hidden */
    --focus-outline-size: calc(var(--focus-outline-offset) + var(--focus-outline-width));

    gap: 0 var(--menu-horizontal-gap);
  }

  .overflow-menu {
    background-color: transparent;
    padding: var(--focus-outline-size);
    margin: calc(-1 * var(--focus-outline-size));
  }

  /* the submenu background element to animate */
  .overflow-menu::after {
    content: '';
    position: absolute;
    top: calc(100% - 1px + var(--border-bottom-width));
    left: 0;
    width: 100%;
    height: var(--submenu-height);
    background-color: var(--color-background);
    box-shadow: none;
    clip-path: inset(0.5px 0 -100px 0); /* stylelint-disable-line */
    opacity: var(--submenu-opacity, 1);
    transition: height var(--submenu-animation-speed) var(--ease-out-cubic),
      opacity var(--animation-speed-slow) var(--ease-out-cubic) var(--animation-speed-fast);
    z-index: calc(var(--layer-header-menu) - 1);
  }

  /** mega menu **/
  .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-padding-block-start: var(--padding-3xl);
    --submenu-padding-block-end: var(--padding-3xl);

    background-color: transparent;
  }

  .header__row[style*='--border-bottom-width: 0px'] {
    .menu-list__submenu.color-scheme-matches-parent,
    .overflow-menu.color-scheme-matches-parent::part(overflow) {
      --submenu-padding-block-start: 0px;
    }
  }

  .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-content-opacity: 0;
    --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.75) var(--animation-easing);

    box-shadow: none;
    visibility: hidden;
    background-color: var(--color-background);
    position: absolute;
    width: 100%;
    left: 0;
    top: calc(100% - 1px + var(--border-bottom-width));
    z-index: var(--layer-header-menu);
    padding-inline: var(--padding-inline);
    clip-path: rect(0 100% var(--submenu-height) 0); /* stylelint-disable-line */
    transition: clip-path var(--submenu-animation-speed) var(--ease-out-cubic);
    
    /* Add padding-top to extend hitbox upward */
    padding-top: 10px;
    margin-top: -10px;
  }

  /* ========================================
     DESKTOP ONLY: Pure CSS Hover Submenus
     Mobile uses original JS behavior
     ======================================== */
  @media screen and (min-width: 990px) {
    /* Show submenu on hover - desktop only */
    .menu-list__list-item:hover > .menu-list__submenu,
    .menu-list__list-item:focus-within > .menu-list__submenu {
      --submenu-content-opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    /* Add delay before hiding submenu */
    .menu-list__list-item > .menu-list__submenu {
      transition: 
        clip-path var(--submenu-animation-speed) var(--ease-out-cubic),
        visibility 0s linear 300ms,
        opacity calc(var(--submenu-animation-speed) * 0.75) var(--animation-easing);
    }

    .menu-list__list-item:hover > .menu-list__submenu,
    .menu-list__list-item:focus-within > .menu-list__submenu {
      transition-delay: 0s, 0s, 0s;
    }
  }

  /* Keep original JS-based behavior for all screen sizes */
  .menu-list__list-item:has([aria-expanded='true']) > .menu-list__submenu,
  .overflow-menu:has([slot="overflow"] [aria-expanded='true'])::part(overflow),
  .menu-list__submenu:is(:hover),
  .overflow-menu::part(overflow):hover {
    --submenu-content-opacity: 1;
    visibility: visible;
  }

  .menu-list__list-item:has([data-animating]) > .menu-list__submenu {
    --submenu-content-opacity: 0;

    visibility: visible;

    &::before {
      height: 0;
    }
  }

  .menu-list__submenu-inner,
  .overflow-menu::part(overflow-list) {
    grid-column: 2;
    padding-block-start: var(--submenu-padding-block-start);
    padding-block-end: var(--submenu-padding-block-end);
    padding-inline: var(--section-padding-inline);
  }

  .overflow-menu::part(overflow) {
    --menu-top-level-font-size: var(--font-size--xlarge);

    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .overflow-menu::part(overflow-list) {
    --submenu-content-opacity: 0;

    position: relative;
    display: grid;
    grid-template-columns: minmax(auto, 200px) 1fr;
    grid-template-areas: 'left right';
    grid-template-rows: max-content;
    grid-gap: 0;
  }

  .menu-list__list-item:is([slot='overflow']) {
    --menu-top-level-font-color: var(--color-foreground);
    --menu-top-level-font-color-rgb: var(--color-foreground-rgb);

    display: contents;
    white-space: normal;

    .menu-list__link {
      --submenu-content-opacity: 0;

      grid-area: left;
      grid-row: auto;
      height: min-content;
      font-size: var(--font-size--xl);
      opacity: var(--submenu-content-opacity);
      transition: var(--submenu-content-animation);
    }

    .menu-list__submenu {
      visibility: hidden;
      grid-row: 1;
      grid-area: right;
      grid-row-end: span calc(var(--overflow-count) + 1);
      padding-inline-start: var(--menu-horizontal-gap);

      .menu-list__submenu-inner {
        padding-block-start: 0;
        grid-column: unset;
      }
    }

    .menu-list__link[aria-expanded='true'] + .menu-list__submenu {
      visibility: visible;
    }
  }

  .header-menu[data-overflow-expanded='true'] .menu-list__list-item:where([slot='overflow']) .menu-list__link {
    --submenu-content-opacity: 1;
  }

  .menu-list__list-item:where([slot='overflow']):has([data-animating]) > .menu-list__link {
    --submenu-content-opacity: 0;
  }

  .menu-list__submenu-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    opacity: var(--submenu-content-opacity);
    transition: var(--submenu-content-animation);
  }

  .mega-menu__link {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);
    white-space: normal;
    text-decoration: none;
    display: inline-flex;
    padding: var(--padding-2xs) 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;

    &::before {
      content: '';
      position: absolute;
      left: -8px;
      top: 50%;
      transform: translateY(-50%) scale(0);
      width: 4px;
      height: 4px;
      background-color: currentColor;
      border-radius: 50%;
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    &:hover {
      color: var(--menu-child-active-font-color);
      padding-left: 12px;
    }

    &:hover::before {
      transform: translateY(-50%) scale(1);
    }
  }

  .mega-menu__link--parent {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);

    &:hover {
      color: var(--menu-parent-active-font-color);
    }
  }

  @media screen and (max-width: 989px) {
    .mega-menu__content-list-item--hidden-tablet {
      display: none;
    }
  }

  .mega-menu__link:has(.mega-menu__link-image) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__link-image {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    object-fit: cover;
    border-radius: var(--menu-image-border-radius);
  }

  /* Collection Submenu with Images Styles */
  .collection-submenu {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--padding-lg);
    padding: var(--padding-xl);
  }

  @media screen and (max-width: 989px) {
    .collection-submenu {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: var(--padding-md);
      padding: var(--padding-lg);
    }
  }

  @media screen and (max-width: 640px) {
    .collection-submenu {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--padding-sm);
      padding: var(--padding-md);
    }
  }

  @media screen and (max-width: 480px) {
    .collection-submenu {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 768px) {
    .collection-submenu {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--padding-md);
      padding: var(--padding-md);
    }
  }

  @media screen and (max-width: 480px) {
    .collection-submenu {
      grid-template-columns: 1fr;
    }
  }

  .collection-submenu__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-submenu__item:hover {
    transform: translateY(-8px);
  }

  .collection-submenu__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: var(--padding-sm);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-submenu__item:hover .collection-submenu__image-wrapper {
    transform: translateY(-2px);
  }

  .collection-submenu__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-submenu__item:hover .collection-submenu__image {
    transform: scale(1.08);
  }

  .collection-submenu__title {
    font-family: var(--menu-child-font-family);
    font-size: var(--menu-child-font-size);
    font-weight: var(--menu-child-font-weight);
    color: var(--menu-child-font-color);
    text-align: center;
    text-transform: var(--title-case);
    margin-top: var(--padding-xs);
    transition: color 0.3s ease;
  }

  @media screen and (max-width: 640px) {
    .collection-submenu__title {
      font-size: 0.875rem;
    }
  }

  .collection-submenu__item:hover .collection-submenu__title {
    color: var(--menu-child-active-font-color);
  }

  /* Text-Only Submenu Styles - Organized Column Layout */
  .text-submenu {
    width: 100%;
    padding: var(--padding-2xl) var(--padding-3xl);
  }

  @media screen and (max-width: 989px) {
    .text-submenu {
      padding: var(--padding-lg) var(--padding-xl);
    }
  }

  @media screen and (max-width: 640px) {
    .text-submenu {
      padding: var(--padding-md) var(--padding-lg);
    }
  }

  .text-submenu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--padding-xl) var(--padding-2xl);
    
    margin: 0 auto;
  }

  @media screen and (max-width: 989px) {
    .text-submenu__grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--padding-lg) var(--padding-xl);
    }
  }

  @media screen and (max-width: 640px) {
    .text-submenu__grid {
      grid-template-columns: 1fr;
      gap: var(--padding-md);
    }
  }

  .text-submenu__column {
    display: flex;
    flex-direction: column;
    gap: var(--padding-sm);
  }

  .text-submenu__parent-link {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);
    text-decoration: none;
    padding-bottom: var(--padding-xs);
    border-bottom: 2px solid rgba(var(--color-foreground-rgb), 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-block;
    margin-bottom: var(--padding-sm);
  }

  .text-submenu__parent-link:hover {
    color: var(--menu-parent-active-font-color);
    border-bottom-color: currentColor;
    transform: translateX(4px);
  }

  .text-submenu__child-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--padding-xs);
  }

  .text-submenu__child-item {
    margin: 0;
  }

  .text-submenu__child-link {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);
    text-decoration: none;
    display: block;
    padding: var(--padding-2xs) 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    padding-left: var(--padding-xs);
  }

  .text-submenu__child-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 2px;
    background-color: currentColor;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .text-submenu__child-link:hover {
    color: var(--menu-child-active-font-color);
    padding-left: calc(var(--padding-sm) + 4px);
  }

  .text-submenu__child-link:hover::before {
    width: 12px;
  }

  @media screen and (max-width: 640px) {
    .text-submenu__parent-link {
      font-size: 1rem;
    }
    
    .text-submenu__child-link {
      font-size: 0.875rem;
    }
  }

  .mega-menu__grid {
    display: grid;
    grid-template-columns: repeat(var(--menu-columns-tablet), minmax(0, 1fr));
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
    width: 100%;

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__column {
    grid-column: span 1;
  }

  .mega-menu__column--span-2 {
    grid-column: span 2;
  }

  .mega-menu__column--span-3 {
    grid-column: span 3;
  }

  .mega-menu__column--span-4 {
    grid-column: span 4;
  }

  .mega-menu__column--collection-image {
    grid-column: span 1;

    @media screen and (min-width: 990px) {
      grid-column: span 2;
    }
  }

  .mega-menu__column--collection-image .mega-menu__link {
    text-transform: var(--title-case);
  }

  .mega-menu__submenu .mega-menu__column--collection-image {
    grid-column: span 1;
  }

  /* Apply title case to featured products and collections */
  .mega-menu__content-list--products .resource-card__title,
  .mega-menu__content-list--collections .resource-card__title {
    text-transform: var(--title-case);
  }

  .mega-menu__content-list {
    display: grid;
    justify-content: end;
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
  }

  .mega-menu__content-list--products {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 1fr));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__content-list--collections {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 300px));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 300px));
    }
  }

  .mega-menu__list {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: span var(--menu-columns-tablet);
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-columns-desktop);
    }
  }

  .mega-menu__content {
    grid-column: span var(--menu-content-columns-tablet) / -1;

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-content-columns-desktop) / -1;
    }
  }

  .menu-list__list-item[slot='overflow'] .section {
    grid-template-columns: 1fr;
  }

  .menu-list__list-item[slot='overflow'] .section .mega-menu__grid {
    grid-column: 1;
  }

  .mega-menu__content-list li {
    white-space: normal;
  }

  /* mega more menu */
  .mega-menu__more-list {
    --menu-child-font-size: var(--font-size--xl);

    width: 200px;
  }

  .mega-menu__more-list-item .mega-menu__link {
    color: rgb(var(--menu-top-level-font-color-rgb) / var(--opacity-subdued-text));
  }

  .mega-menu__more-list-item:where(:hover, .active) .mega-menu__link {
    color: var(--menu-top-level-font-color);
  }

  .mega-menu__more-list-item[aria-hidden='true'] {
    display: none;
  }

  .mega-menu__submenu {
    /* preserves the inherited grid layout when this submenu wrapper is used */
    display: contents;
  }
{% endstylesheet %}

