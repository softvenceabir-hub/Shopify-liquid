}

.product-card__price-sale {
  color: black;
  font-weight: 900;
}

.product-card__price-compare {
  color:rgb(61, 61, 61);
  text-decoration: line-through;
  font-weight: 400;
  font-size: 12px;
}

.product-card__mobile-details .product-card__price-compare {
  font-size: 12px;
