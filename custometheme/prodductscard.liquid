/* Product Details Section */
.product-card__details {
  margin-top: 0.75rem;
  min-height: 60px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
}

.product-card__desktop-details {
  display: none;
}

@media (min-width: 1024px) {
  .product-card__desktop-details {
    display: block;
  }
  .product-card__mobile-details {
    display: none;
  }
}

.product-card__info-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.product-card__title {
  font-size: 11px;
  font-weight: 700;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: -0.025em;
  line-height: 1.25;
}

.product-card__mobile-details .product-card__title {
  font-size: 10px;
}

.product-card__price {
  font-size: 11px;
  font-weight: 700;
  color: #000;
  margin-top: 0.125rem;
  display: flex;
  gap: 0.375rem;
  align-items: center;
}

.product-card__mobile-details .product-card__price {
