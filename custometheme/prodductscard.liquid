{% liquid
  assign section_id = section.id | default: 'product-card-section'
  assign block_id = block.id | default: 'product-card-block'
  assign is_sold_out = false
  
  # Check if product is sold out
  unless product.available
    assign is_sold_out = true
  endunless
  
  # Calculate discount percentage
  assign discount_percentage = 0
  if product.compare_at_price > product.price
    assign discount_amount = product.compare_at_price | minus: product.price
    assign discount_percentage = discount_amount | times: 100 | divided_by: product.compare_at_price
  endif
  
  # Get hover image (second image if available)
  assign hover_image = null
  if product.images.size > 1
    assign hover_image = product.images[1]
  endif
  
  # Get unique sizes by tracking what we've seen
  assign all_variant_data = ''
  assign seen_sizes = ','
  
  for variant in product.variants
    assign size_name = variant.option1 | strip
    assign search_pattern = ',' | append: size_name | append: ','
    
    unless seen_sizes contains search_pattern
      assign seen_sizes = seen_sizes | append: size_name | append: ','
      assign variant_data = variant.id | append: '||' | append: size_name | append: '||' | append: variant.available
      
      if all_variant_data == ''
        assign all_variant_data = variant_data
      else
        assign all_variant_data = all_variant_data | append: ':::' | append: variant_data
      endif
    endunless
  endfor
  
  assign unique_variants_array = all_variant_data | split: ':::'
  
  # Get color swatches from product options
  assign color_swatches = ''
  for option in product.options_with_values
    if option.name == 'Color' or option.name == 'color' or option.name == 'Colour'
      assign color_swatches = option.values
    endif
  endfor
%}

<!-- BHOTY Style Product Card -->
<a href="{{ product.url }}" class="product-card-wrapper {% if is_sold_out %}sold-out{% endif %}" data-product-id="{{ product.id }}">
  
  <!-- Image Container -->
  <div class="product-card__image-container {% if hover_image %}has-hover-image{% endif %}">
    
    <!-- Discount Badge -->
    {% if discount_percentage > 0 %}
      <div class="product-card__discount-badge">
        SAVE {{ discount_percentage }}%
      </div>
    {% endif %}
    
    <!-- Main Image -->
    <img 
      src="{{ product.featured_image | image_url: width: 600 }}" 
      alt="{{ product.title }}"
      class="product-card__image main {% if is_sold_out %}sold-out{% endif %}"
      loading="lazy"
    >
    
    <!-- Hover Image -->
    {% if hover_image %}
      <img 
        src="{{ hover_image | image_url: width: 600 }}" 
        alt="{{ product.title }}"
        class="product-card__image hover"
        loading="lazy"
      >
    {% endif %}
    
    <!-- Sold Out Overlay -->
    {% if is_sold_out %}
      <div class="product-card__sold-out-overlay">
        <div class="product-card__sold-out-text">SOLD OUT</div>
      </div>
    {% endif %}
  </div>
  
  <!-- Product Details -->
  <div class="product-card__details">
    
    <!-- Desktop Details -->
    <div class="product-card__desktop-details">
      <!-- Default View (shown by default) -->
      <div class="product-card__default-view">
        <div class="product-card__info-wrapper">
          <div class="product-card__title">{{ product.title }}</div>
          
          <!-- Price Display -->
          <div class="product-card__price">
            {% if product.compare_at_price > product.price %}
              <span class="product-card__price-sale">{{ product.price | money }}</span>
              <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
            {% else %}
              <span>{{ product.price | money }}</span>
            {% endif %}
          </div>
          
          <!-- Color Swatches -->
          {% if color_swatches != blank and color_swatches.size > 0 %}
            <div class="product-card__color-swatches">
              {% for color in color_swatches limit: 6 %}
                {% assign color_handle = color | handleize %}
                <div class="product-card__color-swatch" data-color="{{ color_handle }}" style="background-color: {{ color }};"></div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Hover View (shown on hover) - Size Selector -->
      {% unless is_sold_out %}
        <div class="product-card__hover-view">
          {% if product.has_only_default_variant == false %}
            <!-- Has Variants - Show Size Selector -->
            <div class="product-card__size-selector">
              {% for variant_info in unique_variants_array %}
                {% unless variant_info == blank %}
                  {% assign variant_parts = variant_info | split: '||' %}
                  {% assign variant_id = variant_parts[0] %}
                  {% assign size_name = variant_parts[1] %}
                  {% assign is_available = variant_parts[2] %}
                  
                  <button 
                    type="button" 
                    class="product-card__size-button"
                    data-variant-id="{{ variant_id }}"
                    data-product-title="{{ product.title }}"
                    data-size="{{ size_name }}"
                    {% if is_available == 'false' %}disabled{% endif %}
                  >
                    {{ size_name }}
                  </button>
                {% endunless %}
              {% endfor %}
            </div>
          {% else %}
            <!-- No Variants - Show ONE SIZE Button -->
            <div class="product-card__quick-add-wrapper" style="display: flex; justify-content: center; width: 100%;">
              <button 
                type="button" 
                class="product-card__size-button"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-product-title="{{ product.title }}"
                data-size="ONE SIZE"
              >
                ONE SIZE
              </button>
            </div>
          {% endif %}
        </div>
      {% endunless %}
    </div>
    
    <!-- Mobile Details -->
    <div class="product-card__mobile-details">
      <div class="product-card__info-wrapper">
        <div class="product-card__title">{{ product.title }}</div>
        
        <!-- Price Display -->
        <div class="product-card__price">
          {% if product.compare_at_price > product.price %}
            <span class="product-card__price-sale">{{ product.price | money }}</span>
            <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
          {% else %}
            <span>{{ product.price | money }}</span>
          {% endif %}
        </div>
        
        <!-- Color Swatches -->
        {% if color_swatches != blank and color_swatches.size > 0 %}
          <div class="product-card__color-swatches">
            {% for color in color_swatches limit: 6 %}
              {% assign color_handle = color | handleize %}
              <div class="product-card__color-swatch" data-color="{{ color_handle }}" style="background-color: {{ color }};"></div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      
      <!-- Mobile Size Selector -->
      {% unless is_sold_out %}
        <div class="product-card__mobile-size-selector">
          {% if product.has_only_default_variant == false %}
            <div class="product-card__size-selector">
              {% for variant_info in unique_variants_array %}
                {% unless variant_info == blank %}
                  {% assign variant_parts = variant_info | split: '||' %}
                  {% assign variant_id = variant_parts[0] %}
                  {% assign size_name = variant_parts[1] %}
                  {% assign is_available = variant_parts[2] %}
                  
                  <button 
                    type="button" 
                    class="product-card__size-button"
                    data-variant-id="{{ variant_id }}"
                    data-product-title="{{ product.title }}"
                    data-size="{{ size_name }}"
                    {% if is_available == 'false' %}disabled{% endif %}
                  >
                    {{ size_name }}
                  </button>
                {% endunless %}
              {% endfor %}
            </div>
          {% else %}
            <div class="product-card__quick-add-wrapper" style="display: flex; justify-content: center; width: 100%;">
              <button 
                type="button" 
                class="product-card__size-button"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-product-title="{{ product.title }}"
                data-size="ONE SIZE"
              >
                ONE SIZE
              </button>
            </div>
          {% endif %}
        </div>
      {% endunless %}
    </div>
  </div>
</a>

<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    initializeBhotyProductCards();
  });
  
  function initializeBhotyProductCards() {
    const sizeButtons = document.querySelectorAll('.product-card__size-button');
    
    sizeButtons.forEach(button => {
      button.addEventListener('click', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // Prevent parent link navigation
        if (e.target.closest('a')) {
          e.target.closest('a').style.pointerEvents = 'none';
          setTimeout(() => {
            if (e.target.closest('a')) {
              e.target.closest('a').style.pointerEvents = '';
            }
          }, 100);
        }
        
        // Don't allow clicking if already adding
        if (this.classList.contains('adding') || this.disabled) {
          return;
        }
        
        const variantId = this.dataset.variantId;
        const productTitle = this.dataset.productTitle;
        const size = this.dataset.size;
        
        if (!variantId) return;
        
        // Visual feedback - show "adding" state
        const originalText = this.textContent;
        this.classList.add('adding');
        this.textContent = '...';
        
        try {
          // Add to cart using Shopify API
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });
          
          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }
          
          const result = await response.json();
          console.log('Added to cart:', result);
          
          // Success feedback
          this.classList.remove('adding');
          this.classList.add('success');
          this.textContent = '✓';
          
          // Refresh and open cart drawer
          await updateCartAndOpenDrawer();
          
          // Reset button after delay
          setTimeout(() => {
            this.classList.remove('success');
            this.textContent = originalText;
          }, 2000);
          
        } catch (error) {
          console.error('Add to cart error:', error);
          
          // Error feedback
          this.classList.remove('adding');
          this.textContent = '✗';
          
          setTimeout(() => {
            this.textContent = originalText;
          }, 2000);
          
          alert('Failed to add to cart. Please try again.');
        }
      });
    });
  }
  
  async function updateCartAndOpenDrawer() {
    try {
      // Get updated cart data
      const cartResponse = await fetch('/cart.js');
      const cart = await cartResponse.json();
      
      console.log('Cart updated:', cart);
      
      // Update cart count elements
      document.querySelectorAll('[data-cart-count], .cart-count, #cart-count').forEach(el => {
        el.textContent = cart.item_count;
      });
      
      const cartBubble = document.querySelector('.cart-bubble');
      if (cartBubble) {
        cartBubble.textContent = cart.item_count;
      }
      
      // Refresh cart drawer content
      await refreshCartDrawer();
      
      // Open the drawer
      setTimeout(() => {
        openCartDrawer();
      }, 300);
      
    } catch (error) {
      console.error('Error updating cart:', error);
      openCartDrawer();
    }
  }
  
  async function refreshCartDrawer() {
    console.log('Refreshing cart drawer content...');
    
    // Method 1: Find and refresh cart section
    const cartItemsComponent = document.querySelector('cart-items-component');
    if (cartItemsComponent) {
      const sectionId = cartItemsComponent.getAttribute('data-section-id') || 
                       findCartSectionId();
      
      if (sectionId) {
        try {
          const response = await fetch(`${window.location.origin}/?section_id=${sectionId}`);
          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newCartItems = doc.querySelector('cart-items-component');
          
          if (newCartItems && cartItemsComponent.parentNode) {
            cartItemsComponent.innerHTML = newCartItems.innerHTML;
            console.log('Cart drawer content refreshed');
          }
        } catch (error) {
          console.error('Error refreshing cart section:', error);
        }
      }
    }
    
    // Dispatch events
    document.dispatchEvent(new CustomEvent('cart:refresh'));
    document.dispatchEvent(new CustomEvent('cart:updated'));
  }
  
  function findCartSectionId() {
    const drawerSection = document.querySelector('[id^="shopify-section-"][id*="cart-drawer"]');
    if (drawerSection) return drawerSection.id.replace('shopify-section-', '');
    
    const headerSection = document.querySelector('[id^="shopify-section-"][id*="header"]');
    if (headerSection) return headerSection.id.replace('shopify-section-', '');
    
    return null;
  }
  
  function openCartDrawer() {
    console.log('Opening cart drawer...');
    
    // Method 1: Try cart-drawer-component
    const cartDrawerComponent = document.querySelector('cart-drawer-component');
    if (cartDrawerComponent) {
      const openButton = cartDrawerComponent.querySelector('button[on\\:click="/open"]');
      if (openButton) {
        openButton.click();
        console.log('Cart drawer opened via component button');
        return;
      }
    }
    
    // Method 2: Open dialog directly
    const dialog = document.querySelector('.cart-drawer__dialog, dialog[class*="cart"]');
    if (dialog && !dialog.open) {
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
        console.log('Cart drawer opened via dialog.showModal()');
        return;
      }
    }
    
    // Method 3: Click cart icon
    const cartIcon = document.querySelector('[aria-label*="cart" i], #cart-icon-bubble');
    if (cartIcon) {
      cartIcon.click();
      console.log('Cart opened via cart icon click');
      return;
    }
    
    // Method 4: Legacy method
    const drawer = document.querySelector('cart-drawer, .cart-drawer');
    if (drawer) {
      drawer.classList.add('is-open', 'active');
      drawer.setAttribute('open', '');
      document.body.classList.add('overflow-hidden');
      console.log('Cart drawer opened via legacy method');
    }
  }
})();
</script>

