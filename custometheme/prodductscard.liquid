/* Color Swatches */
.product-card__color-swatches {
  display: flex;
  gap: 0.375rem;
  margin-top: 0.5rem;
}

.product-card__color-swatch {
  width: 12px;
  height: 12px;
  border-radius: 9999px;
  border: 1.5px solid #e5e7eb;
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

/* Common color mappings */
.product-card__color-swatch[data-color="black"] { background-color: #000000; }
.product-card__color-swatch[data-color="white"] { background-color: #ffffff; border-color: #d1d5db; }
.product-card__color-swatch[data-color="red"] { background-color: #ef4444; }
.product-card__color-swatch[data-color="blue"] { background-color: #3b82f6; }
.product-card__color-swatch[data-color="green"] { background-color: #22c55e; }
.product-card__color-swatch[data-color="yellow"] { background-color: #eab308; }
.product-card__color-swatch[data-color="pink"] { background-color: #ec4899; }
.product-card__color-swatch[data-color="purple"] { background-color: #a855f7; }
.product-card__color-swatch[data-color="orange"] { background-color: #f97316; }
.product-card__color-swatch[data-color="gray"], 
.product-card__color-swatch[data-color="grey"] { background-color: #6b7280; }
.product-card__color-swatch[data-color="brown"] { background-color: #92400e; }
.product-card__color-swatch[data-color="navy"] { background-color: #1e3a8a; }
.product-card__color-swatch[data-color="beige"] { background-color: #d4a574; }
