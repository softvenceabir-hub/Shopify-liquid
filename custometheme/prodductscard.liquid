/* Hide badge when mobile menu is open */
body.overflow-hidden .product-card__discount-badge,
body.menu-open .product-card__discount-badge {
  opacity: 0 !important;
  visibility: hidden !important;
}

@media (min-width: 640px) {
  .product-card__discount-badge {
    font-size: 11px;
    padding: 0.375rem 0.625rem;
  }
}

/* Sold Out Overlay */
.product-card__sold-out-overlay {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.6); pointer-events: none;
}
.product-card__sold-out-text {
  color: #000; font-weight: 900; font-size: 1.2rem; text-transform: uppercase;
}
.product-card-wrapper.sold-out .product-card__image { filter: grayscale(100%); opacity: 0.6; }

@media (min-width: 640px) {
  .product-card__sold-out-text {
    font-size: 1.25rem;
  }
