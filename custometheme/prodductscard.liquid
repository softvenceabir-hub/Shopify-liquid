<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');

/* CRITICAL: Prevent sticky behavior from parent sections */
.section-resource-list,
.section-resource-list *,
.resource-list,
.resource-list *,
.resource-list__item,
.resource-list__item * {
  position: static !important;
}

/* Re-enable positioning only for specific elements that need it */
.section-resource-list,
.resource-list,
.resource-list--grid,
.resource-list__carousel,
.resource-list__item {
  position: relative !important;
}

/* Lower z-index of entire section when mobile menu is open */
body.overflow-hidden .section-resource-list,
body.menu-open .section-resource-list,
body.overflow-hidden .resource-list,
body.menu-open .resource-list {
  z-index: 0 !important;
}

/* BHOTY Product Card Style */
.product-card-wrapper {
  font-family: 'Inter', sans-serif;
  position: relative !important;
  display: flex;
  flex-direction: column;
  width: 100%;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  z-index: 1;
}
.product-card-wrapper:hover { text-decoration: none; }

/* Lower z-index when menu is open */
body.overflow-hidden .product-card-wrapper,
body.menu-open .product-card-wrapper {
  z-index: 0 !important;
}

/* Ensure no sticky positioning anywhere in the card */
.product-card-wrapper,
.product-card-wrapper * {
  position: static;
}

.product-card-wrapper {
  position: relative !important;
}

.product-card__image-container {
  position: relative !important;
}

.product-card__discount-badge {
  position: absolute !important;
}

.product-card__image.hover {
  position: absolute !important;
}

.product-card__sold-out-overlay {
  position: absolute !important;
}

/* Image Area */
.product-card__image-container {
  aspect-ratio: 4/5;
  overflow: hidden;
  background-color: #F0F2FF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}
.product-card__image.main { opacity: 1; }
.product-card__image.hover { position: absolute; top: 0; left: 0; opacity: 0; }

.product-card-wrapper:hover .product-card__image-container.has-hover-image .product-card__image.main { opacity: 0; }
.product-card-wrapper:hover .product-card__image.hover { opacity: 1; }

/* Discount Badge - Prevent any sticky behavior */
.product-card__discount-badge {
  position: absolute !important;
  top: 0.5rem;
  left: 0.5rem;
  background-color: #000;
  color: white;
  font-size: 10px;
  font-weight: 900;
  padding: 0.25rem 0.5rem;
  text-transform: uppercase;
  letter-spacing: -0.025em;
  z-index: 1 !important; /* Very low z-index to stay below menu */
