<script>
document.addEventListener('DOMContentLoaded', function() {
  // AUTO-CLEAR SUCCESS MESSAGE after 3 seconds
  const successMsg = document.getElementById('newsletter-success-msg');
  if (successMsg) {
    setTimeout(function() {
      successMsg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      successMsg.style.opacity = '0';
      successMsg.style.transform = 'translateY(-10px)';
      setTimeout(function() {
        successMsg.remove();
      }, 500);
    }, 3000); // 3 seconds
  }
  
  // Gender preference handling
  const genderRadios = document.querySelectorAll('.gender-preference-radio');
  const hiddenField = document.getElementById('gender-preference-hidden');
  
  genderRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      if (this.checked && hiddenField) hiddenField.value = this.value;
    });
  });
  
  const checkedRadio = document.querySelector('.gender-preference-radio:checked');
  if (checkedRadio && hiddenField) hiddenField.value = checkedRadio.value;
  
  // Size selection
  let selectedVariantId = null;
  const sizeRadios = document.querySelectorAll('input[name="size"]');
  sizeRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      if (this.checked) selectedVariantId = this.dataset.variantId;
    });
  });
  
  const firstSizeRadio = document.querySelector('input[name="size"]:checked');
  if (firstSizeRadio) selectedVariantId = firstSizeRadio.dataset.variantId;
  
  // Add to cart
  document.querySelectorAll('.add-to-cart-btn, .quick-add-btn').forEach(button => {
    button.addEventListener('click', function() {
      const variantId = selectedVariantId || this.dataset.productId;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      }).then(r => r.json()).then(() => {
        const msg = document.createElement('div');
        msg.style.cssText = 'position:fixed;top:20px;right:20px;background:#10b981;color:white;padding:1rem 1.5rem;border-radius:4px;z-index:1000;';
        msg.textContent = 'Product added!';
        document.body.appendChild(msg);
        setTimeout(() => msg.remove(), 3000);
      }).catch(console.error);
    });
  });
  
  // LOCALE MODAL FUNCTIONALITY
  const modal = document.getElementById('localeModal');
  const modalBtn = document.getElementById('localeModalBtn');
  const modalClose = document.getElementById('localeModalClose');
  const modalOverlay = document.getElementById('localeModalOverlay');
  const confirmBtn = document.getElementById('modalConfirmBtn');
  
  // Open modal
  if (modalBtn) {
    modalBtn.addEventListener('click', function() {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  }
  
  // Close modal
  function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }
  
  if (modalClose) {
    modalClose.addEventListener('click', closeModal);
  }
  
  if (modalOverlay) {
    modalOverlay.addEventListener('click', closeModal);
  }
  
  // ESC key to close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('active')) {
      closeModal();
    }
  });
  
  // Handle confirm button - submit both forms
  if (confirmBtn) {
    confirmBtn.addEventListener('click', function() {
      const countrySelect = document.getElementById('countrySelect');
      const languageSelect = document.getElementById('languageSelect');
      const countryForm = document.getElementById('ModalCountryForm');
      const languageForm = document.getElementById('ModalLanguageForm');
      
      // Check if country changed
      const currentCountry = countryForm.querySelector('input[name="country_code"]');
      const selectedCountry = countrySelect.value;
      
      // Check if language changed
      const currentLanguage = languageForm.querySelector('input[name="locale_code"]');
      const selectedLanguage = languageSelect.value;
      
      // Create hidden inputs and submit country form (which will trigger page reload)
      if (countryForm) {
        // Remove any existing hidden inputs
        const existingInputs = countryForm.querySelectorAll('input[type="hidden"][name="country_code"]');
        existingInputs.forEach(input => input.remove());
        
        // Add new hidden input with selected value
        const hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = 'country_code';
        hiddenInput.value = selectedCountry;
        countryForm.appendChild(hiddenInput);
        
        // Also add language if different
        const langInput = document.createElement('input');
        langInput.type = 'hidden';
        langInput.name = 'locale_code';
        langInput.value = selectedLanguage;
        countryForm.appendChild(langInput);
        
        countryForm.submit();
      }
    });
  }
});
</script>

