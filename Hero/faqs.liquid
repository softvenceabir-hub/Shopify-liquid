<style>
  #faq-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #faq-{{ section.id }} .faq-container {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_left_desktop }}px;
    padding-right: {{ section.settings.padding_right_desktop }}px;
  }

  /* ── Header ── */
  #faq-{{ section.id }} .faq-eyebrow {

    font-weight: 300;
    font-size: {{ section.settings.eyebrow_font_size_desktop }}px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #faq-{{ section.id }} .faq-eyebrow::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: {{ section.settings.eyebrow_color }};
    flex-shrink: 0;
  }

  #faq-{{ section.id }} .faq-title {

    font-size: {{ section.settings.title_font_size_desktop }}px;
    font-weight: {{ section.settings.title_font_weight }};
    line-height: 1.08;
    color: {{ section.settings.title_color }};
    margin-bottom: 16px;
  }
  #faq-{{ section.id }} .faq-title em {
    font-style: italic;
    color: {{ section.settings.title_italic_color }};
  }

  #faq-{{ section.id }} .faq-subtitle {

    font-size: {{ section.settings.subtitle_font_size_desktop }}px;
    font-weight: {{ section.settings.subtitle_font_weight }};
    color: {{ section.settings.subtitle_color }};
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: 48px;
  }

  /* ── Category Tabs ── */
  #faq-{{ section.id }} .faq-categories {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  #faq-{{ section.id }} .cat-btn {
    background: {{ section.settings.tab_bg_color }};
    border: 1px solid {{ section.settings.tab_border_color }};
    color: {{ section.settings.tab_text_color }};

    font-size: {{ section.settings.tab_font_size_desktop }}px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 9px 20px;
    cursor: pointer;
    border-radius: 40px;
    transition: all 0.25s ease;
  }
  #faq-{{ section.id }} .cat-btn:hover {
    background: {{ section.settings.tab_hover_bg_color }};
    border-color: {{ section.settings.tab_hover_border_color }};
    color: {{ section.settings.tab_hover_text_color }};
  }
  #faq-{{ section.id }} .cat-btn.active {
    background: {{ section.settings.tab_active_bg_color }};
    border-color: {{ section.settings.tab_active_border_color }};
    color: {{ section.settings.tab_active_text_color }};
  }

  /* ── FAQ Items ── */
  #faq-{{ section.id }} .faq-list {
    display: flex;
    flex-direction: column;
  }
  #faq-{{ section.id }} .faq-item {
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }
  #faq-{{ section.id }} .faq-item:first-child {
    border-top: 1px solid {{ section.settings.divider_color }};
  }
  #faq-{{ section.id }} .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ section.settings.faq_item_padding_desktop }}px 0;
    cursor: pointer;
    gap: 24px;
    user-select: none;
  }
  #faq-{{ section.id }} .q-text {

    font-size: {{ section.settings.question_font_size_desktop }}px;
    font-weight: {{ section.settings.question_font_weight }};
    line-height: 1.4;
    color: {{ section.settings.question_color }};
    transition: color 0.2s;
    flex: 1;
  }
  #faq-{{ section.id }} .faq-question:hover .q-text {
    color: {{ section.settings.question_hover_color }};
  }

  #faq-{{ section.id }} .q-icon {
    width: 36px;
    height: 36px;
    border: 1px solid {{ section.settings.divider_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
    position: relative;
  }
  #faq-{{ section.id }} .q-icon::before,
  #faq-{{ section.id }} .q-icon::after {
    content: '';
    position: absolute;
    background: {{ section.settings.icon_color }};
    border-radius: 2px;
    transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
  }
  #faq-{{ section.id }} .q-icon::before { width: 12px; height: 1.5px; }
  #faq-{{ section.id }} .q-icon::after  { width: 1.5px; height: 12px; }

  #faq-{{ section.id }} .faq-item.open .q-icon {
    background: {{ section.settings.tab_active_bg_color }};
    border-color: {{ section.settings.tab_active_bg_color }};
  }
  #faq-{{ section.id }} .faq-item.open .q-icon::before,
  #faq-{{ section.id }} .faq-item.open .q-icon::after {
    background: {{ section.settings.tab_active_text_color }};
  }
  #faq-{{ section.id }} .faq-item.open .q-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  #faq-{{ section.id }} .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.45s cubic-bezier(0.4,0,0.2,1);
  }
  #faq-{{ section.id }} .faq-answer-inner {
    padding: 0 0 24px 0;

    font-size: {{ section.settings.answer_font_size_desktop }}px;
    font-weight: {{ section.settings.answer_font_weight }};
    line-height: 1.8;
    color: {{ section.settings.answer_color }};
    max-width: 700px;
  }
  #faq-{{ section.id }} .faq-answer-inner a {
    color: {{ section.settings.tab_active_bg_color }};
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  #faq-{{ section.id }} .faq-answer-inner a:hover {
    border-color: {{ section.settings.tab_active_bg_color }};
  }
  #faq-{{ section.id }} .faq-answer-inner strong {
    color: {{ section.settings.question_color }};
    font-weight: 600;
  }

  /* ── Contact Strip ── */
  #faq-{{ section.id }} .faq-contact {
    margin-top: 64px;
    padding: 40px 48px;
    border: 1px solid {{ section.settings.divider_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  #faq-{{ section.id }} .contact-text h3 {

    font-size: 22px;
    font-weight: 400;
    color: {{ section.settings.title_color }};
    margin-bottom: 6px;
  }
  #faq-{{ section.id }} .contact-text p {
    font-size: 14px;
    font-weight: 300;
    color: {{ section.settings.answer_color }};
  }
  #faq-{{ section.id }} .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1px solid {{ section.settings.tab_active_bg_color }};
    color: {{ section.settings.tab_active_bg_color }};

    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px 28px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  #faq-{{ section.id }} .contact-btn:hover {
    background: {{ section.settings.tab_active_bg_color }};
    color: {{ section.settings.tab_active_text_color }};
  }
  #faq-{{ section.id }} .contact-btn svg { transition: transform 0.25s; }
  #faq-{{ section.id }} .contact-btn:hover svg { transform: translateX(4px); }

  /* ════════════════════════════════
     MOBILE STYLES
     ════════════════════════════════ */
  @media (max-width: 767px) {
    #faq-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #faq-{{ section.id }} .faq-container {
      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;
    }
    #faq-{{ section.id }} .faq-eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
    }
    #faq-{{ section.id }} .faq-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    #faq-{{ section.id }} .faq-subtitle {
      font-size: {{ section.settings.subtitle_font_size_mobile }}px;
    }
    #faq-{{ section.id }} .cat-btn {
      font-size: {{ section.settings.tab_font_size_mobile }}px;
      padding: 8px 16px;
    }
    #faq-{{ section.id }} .q-text {
      font-size: {{ section.settings.question_font_size_mobile }}px;
    }
    #faq-{{ section.id }} .faq-question {
      padding: {{ section.settings.faq_item_padding_mobile }}px 0;
    }
    #faq-{{ section.id }} .faq-answer-inner {
      font-size: {{ section.settings.answer_font_size_mobile }}px;
    }
    #faq-{{ section.id }} .faq-contact {
      padding: 28px 20px;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<section id="faq-{{ section.id }}">
  <div class="faq-container">

    <!-- Header -->
    <div class="faq-header">
      {% if section.settings.eyebrow != blank %}
        <div class="faq-eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="faq-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="faq-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Category Tabs -->
    {% assign categories = '' %}
    {% for block in section.blocks %}
      {% if block.type == 'faq_item' %}
        {% assign cat = block.settings.category | downcase | strip %}
        {% unless categories contains cat %}
          {% assign categories = categories | append: cat | append: ',' %}
        {% endunless %}
      {% endif %}
    {% endfor %}

    {% assign final_cats = categories | split: ',' %}

    {% if section.settings.show_tabs and final_cats.size > 1 %}
    <div class="faq-categories" id="faq-cats-{{ section.id }}">
      <button class="cat-btn active" data-cat="all">All</button>
      {% for cat in final_cats %}
        {% if cat != blank %}
          <button class="cat-btn" data-cat="{{ cat }}">{{ cat | capitalize }}</button>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <!-- FAQ Items -->
    <div class="faq-list" id="faqList-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="faq-item" data-cat="{{ block.settings.category | downcase | strip }}" {{ block.shopify_attributes }}>
            <div class="faq-question">
              <span class="q-text">{{ block.settings.question }}</span>
              <span class="q-icon"></span>
            </div>
            <div class="faq-answer">
              <div class="faq-answer-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Contact Strip -->
    {% if section.settings.show_contact %}
    <div class="faq-contact">
      <div class="contact-text">
        <h3>{{ section.settings.contact_heading }}</h3>
        <p>{{ section.settings.contact_subtext }}</p>
      </div>
      <a href="{{ section.settings.contact_link }}" class="contact-btn">
        {{ section.settings.contact_button_label }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
    {% endif %}

  </div>
</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var listEl    = document.getElementById('faqList-' + sectionId);
  var catEl     = document.getElementById('faq-cats-' + sectionId);

  if (!listEl) return;

  /* ── Accordion ── */
  listEl.addEventListener('click', function(e) {
    var question = e.target.closest('.faq-question');
    if (!question) return;

    var item    = question.closest('.faq-item');
    var answer  = item.querySelector('.faq-answer');
    var inner   = item.querySelector('.faq-answer-inner');
    var isOpen  = item.classList.contains('open');

    /* close all */
    listEl.querySelectorAll('.faq-item.open').forEach(function(el) {
      el.classList.remove('open');
      el.querySelector('.faq-answer').style.maxHeight = '0';
    });

    if (!isOpen) {
      item.classList.add('open');
      answer.style.maxHeight = (inner.scrollHeight + 28) + 'px';
    }
  });

  /* ── Category filter ── */
  if (catEl) {
    catEl.addEventListener('click', function(e) {
      var btn = e.target.closest('.cat-btn');
      if (!btn) return;

      catEl.querySelectorAll('.cat-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');

      var chosen = btn.dataset.cat;

      /* close all open items */
      listEl.querySelectorAll('.faq-item.open').forEach(function(el) {
        el.classList.remove('open');
        el.querySelector('.faq-answer').style.maxHeight = '0';
      });

      listEl.querySelectorAll('.faq-item').forEach(function(item) {
        if (chosen === 'all' || item.dataset.cat === chosen) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  }
})();
</script>

