{% comment %} {% comment %}
  Custom Collection Hover Section (Dynamic Controls + Responsive Corner Arrows)
  - Grid / Horizontal Scroll layout switch
  - Dynamic slider controls:
      * Dots only
      * Arrows only
      * Dots + Arrows
      * None
  - Dots top-center
  - Arrows sit near image-row corners (desktop + mobile), slightly away from images
  - Hidden native scrollbar
  - Section width controls (% and px)
  - Desktop/Mobile padding controls
  - Desktop/Mobile typography controls
  - Text transform controls
{% endcomment %}

{%- liquid
  assign sec_id = section.id
  assign is_scroll = false
  if section.settings.layout_mode == 'scroll'
    assign is_scroll = true
  endif

  assign show_controls = false
  assign show_dots_overlay = false
  assign show_arrows_overlay = false

  if is_scroll and section.blocks.size > 1
    if section.settings.slider_controls_mode == 'dots'
      assign show_controls = true
      assign show_dots_overlay = true
    elsif section.settings.slider_controls_mode == 'arrows'
      assign show_controls = true
      assign show_arrows_overlay = true
    elsif section.settings.slider_controls_mode == 'both'
      assign show_controls = true
      assign show_dots_overlay = true
      assign show_arrows_overlay = true
    endif
  endif
-%}

<section id="shopify-section-{{ sec_id }}" class="cc-hover-sec cc-hover-sec--{{ sec_id }}">
  <div class="cc-hover-sec__outer {% if section.settings.width_mode == 'percent' %}width-percent{% else %}width-px{% endif %} {% if section.settings.layout_mode == 'scroll' %}layout-scroll{% else %}layout-grid{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="cc-hover-sec__head">
        <h2 class="cc-hover-sec__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if show_controls -%}
      <div class="cc-hover-sec__controls-overlay-wrap">
        {%- if show_arrows_overlay -%}
          <div class="cc-hover-sec__arrows cc-hover-sec__arrows--overlay" aria-label="Slider arrows">
            <button type="button" class="cc-scroll-btn cc-scroll-btn--prev" aria-label="Previous">
              <span aria-hidden="true">‹</span>
            </button>
            <button type="button" class="cc-scroll-btn cc-scroll-btn--next" aria-label="Next">
              <span aria-hidden="true">›</span>
            </button>
          </div>
        {%- endif -%}

        {%- if show_dots_overlay -%}
          <div class="cc-hover-sec__controls cc-hover-sec__controls--overlay">
            <div class="cc-scroll-dots" aria-label="Slider dots">
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="cc-scroll-dot {% if forloop.first %}is-active{% endif %}"
                  data-dot-index="{{ forloop.index0 }}"
                  aria-label="Go to item {{ forloop.index }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc-hover-sec__grid" aria-label="Collection list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_title = block.settings.title
          assign card_subtitle = block.settings.subtitle
          assign card_link = block.settings.link
          assign has_link = false
          if card_link != blank
            assign has_link = true
          endif
        -%}

        {%- if has_link -%}
          <a
            href="{{ card_link }}"
            class="cc-card"
            {{ block.shopify_attributes }}
            style="--circle-bg: {{ block.settings.circle_bg }}; --hover-bg: {{ block.settings.hover_bg }};"
          >
        {%- else -%}
          <div
            class="cc-card"
            {{ block.shopify_attributes }}
            style="--circle-bg: {{ block.settings.circle_bg }}; --hover-bg: {{ block.settings.hover_bg }};"
          >
        {%- endif -%}

            <div class="cc-card__visual">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'cc-card__img',
                    loading: 'lazy',
                    widths: '240,360,480,720,900',
                    sizes: '(max-width: 768px) 90vw, (max-width: 1200px) 33vw, 400px',
                    alt: card_title
                }}
              {%- else -%}
                <div class="cc-card__img cc-card__img--placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              {%- if section.settings.show_hover_label -%}
                <span class="cc-card__hover-label">{{ section.settings.hover_label_text }}</span>
              {%- endif -%}
            </div>

            <div class="cc-card__content">
              {%- if card_title != blank -%}
                <h3 class="cc-card__title">{{ card_title }}</h3>
              {%- endif -%}
              {%- if card_subtitle != blank -%}
                <p class="cc-card__subtitle">{{ card_subtitle }}</p>
              {%- endif -%}
            </div>

        {%- if has_link -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .cc-hover-sec--{{ sec_id }} {
    --sec-bg: {{ section.settings.section_bg }};
    --max-width-px: {{ section.settings.section_max_width_px }}px;
    --width-percent: {{ section.settings.section_width_percent }}%;
    --pad-top-d: {{ section.settings.padding_top_desktop }}px;
    --pad-bottom-d: {{ section.settings.padding_bottom_desktop }}px;
    --pad-left-d: {{ section.settings.padding_left_desktop }}px;
    --pad-right-d: {{ section.settings.padding_right_desktop }}px;

    --pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --pad-left-m: {{ section.settings.padding_left_mobile }}px;
    --pad-right-m: {{ section.settings.padding_right_mobile }}px;

    --heading-color: {{ section.settings.heading_color }};
    --heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --heading-weight: {{ section.settings.heading_weight }};
    --heading-transform: {{ section.settings.heading_transform }};

    --title-color: {{ section.settings.title_color }};
    --title-size-d: {{ section.settings.title_size_desktop }}px;
    --title-size-m: {{ section.settings.title_size_mobile }}px;
    --title-weight: {{ section.settings.title_weight }};
    --title-transform: {{ section.settings.title_transform }};

    --subtitle-color: {{ section.settings.subtitle_color }};
    --subtitle-size-d: {{ section.settings.subtitle_size_desktop }}px;
    --subtitle-size-m: {{ section.settings.subtitle_size_mobile }}px;
    --subtitle-weight: {{ section.settings.subtitle_weight }};
    --subtitle-transform: {{ section.settings.subtitle_transform }};

    --card-gap-d: {{ section.settings.grid_gap_desktop }}px;
    --card-gap-m: {{ section.settings.grid_gap_mobile }}px;
    --card-height-d: {{ section.settings.card_height_desktop }}px;
    --card-height-m: {{ section.settings.card_height_mobile }}px;
    --img-max-h-d: {{ section.settings.image_max_height_desktop }}px;
    --img-max-h-m: {{ section.settings.image_max_height_mobile }}px;
    --circle-size-d: {{ section.settings.circle_size_desktop }}px;
    --circle-size-m: {{ section.settings.circle_size_mobile }}px;
    --radius: {{ section.settings.card_radius }}px;

    /* Arrow placement offsets (corner-like, image theke halka dure) */
    --arrow-edge-offset-d: 6px;
    --arrow-edge-offset-m: 2px;

    background: var(--sec-bg);
    padding-top: var(--pad-top-d);
    padding-bottom: var(--pad-bottom-d);
    padding-left: var(--pad-left-d);
    padding-right: var(--pad-right-d);
  }

  .cc-hover-sec--{{ sec_id }} * { box-sizing: border-box; }

  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__outer {
    margin: 0 auto;
    position: relative;
    overflow: visible;
  }

  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__outer.width-percent {
    width: min(var(--width-percent), 100%);
    max-width: var(--max-width-px);
  }

  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__outer.width-px {
    width: min(100%, var(--max-width-px));
    max-width: var(--max-width-px);
  }

  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__head {
    margin-bottom: 24px;
    text-align: {{ section.settings.heading_align }};
  }

  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__heading {
    margin: 0;
    color: var(--heading-color);
    font-size: var(--heading-size-d);
    font-weight: var(--heading-weight);
    line-height: 1.2;
    font-style: normal;
    text-transform: var(--heading-transform);
  }

  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__grid {
    display: grid;
    gap: var(--card-gap-d);
  }

  .cc-hover-sec--{{ sec_id }} .layout-grid .cc-hover-sec__grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
  }

  .cc-hover-sec--{{ sec_id }} .layout-scroll .cc-hover-sec__grid {
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--card-gap-d) * ({{ section.settings.scroll_items_desktop }} - 1))) / {{ section.settings.scroll_items_desktop }});
    grid-template-columns: none;
    overflow-x: auto;
    overflow-y: hidden;
    padding-top: 22px; /* dots top-center space */
    padding-bottom: 0;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .cc-hover-sec--{{ sec_id }} .layout-scroll .cc-hover-sec__grid::-webkit-scrollbar {
    display: none;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card {
    display: block;
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__visual {
    position: relative;
    height: var(--card-height-d);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius);
    background: transparent;
    padding: 20px;
    transition: background-color .32s ease, transform .28s ease;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__visual::before {
    content: "";
    position: absolute;
    width: var(--circle-size-d);
    height: var(--circle-size-d);
    border-radius: 999px;
    background: var(--circle-bg, #e8f3ee);
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: opacity .32s ease, transform .32s ease;
    z-index: 1;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__img {
    position: relative;
    z-index: 2;
    width: auto;
    max-width: 100%;
    max-height: var(--img-max-h-d);
    height: auto;
    object-fit: contain;
    transition: transform .32s ease;
    filter: drop-shadow(8px 14px 18px rgba(0,0,0,.12));
    display: block;
    font-style: normal;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__img--placeholder {
    position: relative;
    z-index: 2;
    width: 70%;
    max-width: 260px;
    opacity: .65;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__img--placeholder svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__hover-label {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
    border: 1px solid #222;
    color: #222;
    font-size: 12px;
    line-height: 1;
    padding: 7px 11px;
    z-index: 3;
    opacity: 0;
    visibility: hidden;
    transition: all .22s ease;
    pointer-events: none;
    white-space: nowrap;
    font-style: normal;
    text-transform: none;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__content {
    text-align: {{ section.settings.text_align }};
    margin-top: 14px;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__title {
    margin: 0;
    color: var(--title-color);
    font-size: var(--title-size-d);
    font-weight: var(--title-weight);
    line-height: 1.2;
    font-style: normal;
    text-transform: var(--title-transform);
    min-height: 2.4em;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card__subtitle {
    margin: 8px 0 0;
    color: var(--subtitle-color);
    font-size: var(--subtitle-size-d);
    font-weight: var(--subtitle-weight);
    line-height: 1.35;
    font-style: normal;
    text-transform: var(--subtitle-transform);
  }

  .cc-hover-sec--{{ sec_id }} .cc-card:hover .cc-card__visual {
    background: var(--hover-bg, #efe2d6);
  }
  .cc-hover-sec--{{ sec_id }} .cc-card:hover .cc-card__visual::before {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.88);
  }
  .cc-hover-sec--{{ sec_id }} .cc-card:hover .cc-card__img { transform: scale(1.03); }
  .cc-hover-sec--{{ sec_id }} .cc-card:hover .cc-card__hover-label {
    opacity: 1;
    visibility: visible;
    right: 22px;
  }

  .cc-hover-sec--{{ sec_id }} .cc-card.is-touch-active .cc-card__visual {
    background: var(--hover-bg, #efe2d6);
  }
  .cc-hover-sec--{{ sec_id }} .cc-card.is-touch-active .cc-card__visual::before {
    opacity: 0;
    transform: translate(-50%, -50%) scale(.88);
  }
  .cc-hover-sec--{{ sec_id }} .cc-card.is-touch-active .cc-card__img { transform: scale(1.03); }
  .cc-hover-sec--{{ sec_id }} .cc-card.is-touch-active .cc-card__hover-label {
    opacity: 1;
    visibility: visible;
    right: 22px;
  }

  /* Controls wrapper */
  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__controls-overlay-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 25;
    pointer-events: none;
    min-height: 44px;
  }

  /* Dots top-center */
  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__controls--overlay {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-dots {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 auto;
    background: transparent;
    border: 0;
    border-radius: 999px;
    padding: 0;
    pointer-events: auto;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-dot {
    appearance: none;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 0;
    background: #bdbdbd;
    cursor: pointer;
    padding: 0;
    transition: all .2s ease;
    flex: 0 0 auto;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-dot.is-active {
    width: 24px;
    background: #4a4a4a;
  }

  /* Arrows on image row corners (slightly away from images) */
  .cc-hover-sec--{{ sec_id }} .cc-hover-sec__arrows--overlay {
    position: absolute;
    top: calc(62px + (var(--card-height-d) / 2));
    left: -20px;
    right: -20px;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-btn {
    appearance: none;
    border: 1px solid #d9d9d9;
    background: #f7f7f7;
    color: #222;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    cursor: pointer;
    line-height: 1;
    font-size: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all .2s ease;
    padding: 0;
    pointer-events: auto;
    box-shadow: none;
    flex: 0 0 auto;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-btn:hover {
    background: #fff;
    border-color: #cfcfcf;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-btn[disabled] {
    opacity: .45;
    cursor: not-allowed;
  }

  .cc-hover-sec--{{ sec_id }} .cc-scroll-btn span {
    display: inline-block;
    line-height: 1;
    font-size: 22px;
    font-weight: 400;
    transform: translateY(-1px);
  }

  @media (min-width: 1200px) {
    .cc-hover-sec--{{ sec_id }} .cc-scroll-btn {
      width: 42px;
      height: 42px;
    }
    .cc-hover-sec--{{ sec_id }} .cc-scroll-btn span {
      font-size: 24px;
    }
  }

  @media (max-width: 991px) {
    .cc-hover-sec--{{ sec_id }} {
      padding-top: var(--pad-top-m);
      padding-bottom: var(--pad-bottom-m);
      padding-left: var(--pad-left-m);
      padding-right: var(--pad-right-m);
    }

    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__head { margin-bottom: 18px; }
    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__heading { font-size: var(--heading-size-m); }

    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__grid { gap: var(--card-gap-m); }

    .cc-hover-sec--{{ sec_id }} .layout-grid .cc-hover-sec__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }

    .cc-hover-sec--{{ sec_id }} .layout-scroll .cc-hover-sec__grid {
      grid-auto-columns: calc((100% - (var(--card-gap-m) * ({{ section.settings.scroll_items_mobile_num }} - 1))) / {{ section.settings.scroll_items_mobile_num }});
      padding-top: 18px;
    }

    .cc-hover-sec--{{ sec_id }} .cc-card__visual {
      height: var(--card-height-m);
      padding: 14px;
    }

    .cc-hover-sec--{{ sec_id }} .cc-card__visual::before {
      width: var(--circle-size-m);
      height: var(--circle-size-m);
    }

    .cc-hover-sec--{{ sec_id }} .cc-card__img { max-height: var(--img-max-h-m); }
    .cc-hover-sec--{{ sec_id }} .cc-card__title { font-size: var(--title-size-m); }
    .cc-hover-sec--{{ sec_id }} .cc-card__subtitle { font-size: var(--subtitle-size-m); }

    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__controls-overlay-wrap {
      top: 0;
      min-height: 34px;
    }

    /* mobile e arrows image corner e, halka dure */
    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__arrows--overlay {
      top: calc(18px + (var(--card-height-m) / 2));
      left: var(--arrow-edge-offset-m);
      right: var(--arrow-edge-offset-m);
    }

    .cc-hover-sec--{{ sec_id }} .cc-scroll-btn {
      width: 34px;
      height: 34px;
    }

    .cc-hover-sec--{{ sec_id }} .cc-scroll-btn span {
      font-size: 20px;
      transform: translateY(-1px);
    }

    .cc-hover-sec--{{ sec_id }} .cc-scroll-dots {
      gap: 7px;
    }
    .cc-hover-sec--{{ sec_id }} .cc-scroll-dot {
      width: 7px;
      height: 7px;
    }
    .cc-hover-sec--{{ sec_id }} .cc-scroll-dot.is-active {
      width: 18px;
    }

    {% if section.settings.hide_hover_label_mobile %}
    .cc-hover-sec--{{ sec_id }} .cc-card__hover-label { display: none; }
    {% endif %}
  }

  @media (max-width: 575px) {
    .cc-hover-sec--{{ sec_id }} .cc-scroll-btn {
      width: 30px;
      height: 30px;
    }

    .cc-hover-sec--{{ sec_id }} .cc-scroll-btn span {
      font-size: 17px;
    }

    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__arrows--overlay {
      left: 0;
      right: 0;
    }
  }

  /* Desktop only: arrows a little outside section edge if needed */
  @media (min-width: 992px) {
    .cc-hover-sec--{{ sec_id }} .cc-hover-sec__controls-overlay-wrap {
      left: -10px;
      right: -10px;
    }
  }
</style>

<script>
  (function() {
    const root = document.getElementById('shopify-section-{{ sec_id }}');
    if (!root) return;

    const grid = root.querySelector('.layout-scroll .cc-hover-sec__grid');
    const cards = root.querySelectorAll('.cc-card');

    cards.forEach((card) => {
      card.addEventListener('touchstart', function() {
        cards.forEach(c => c.classList.remove('is-touch-active'));
        this.classList.add('is-touch-active');
      }, { passive: true });
    });

    if (!grid) return;

    const prevBtn = root.querySelector('.cc-scroll-btn--prev');
    const nextBtn = root.querySelector('.cc-scroll-btn--next');
    const dots = root.querySelectorAll('.cc-scroll-dot');

    function getCardStep() {
      const first = grid.querySelector('.cc-card');
      if (!first) return 0;

      const cardWidth = first.getBoundingClientRect().width;
      const styles = window.getComputedStyle(grid);

      let gap = parseFloat(styles.columnGap);
      if (isNaN(gap)) gap = parseFloat(styles.gap);
      if (isNaN(gap)) gap = 0;

      return cardWidth + gap;
    }

    function clamp(n, min, max) {
      return Math.max(min, Math.min(max, n));
    }

    function currentIndex() {
      const step = getCardStep();
      if (!step) return 0;
      return clamp(Math.round(grid.scrollLeft / step), 0, Math.max(0, cards.length - 1));
    }

    function updateDots() {
      if (!dots.length) return;
      const idx = currentIndex();
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === idx));
    }

    function updateArrows() {
      if (!prevBtn && !nextBtn) return;
      const maxScroll = Math.max(0, grid.scrollWidth - grid.clientWidth - 1);
      if (prevBtn) prevBtn.disabled = grid.scrollLeft <= 2;
      if (nextBtn) nextBtn.disabled = grid.scrollLeft >= maxScroll;
    }

    function scrollByStep(dir) {
      const step = getCardStep();
      if (!step) return;
      grid.scrollBy({ left: dir * step, behavior: 'smooth' });
    }

    if (prevBtn) prevBtn.addEventListener('click', () => scrollByStep(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => scrollByStep(1));

    dots.forEach((dot) => {
      dot.addEventListener('click', function() {
        const i = parseInt(this.getAttribute('data-dot-index') || '0', 10);
        const step = getCardStep();
        if (!step) return;
        grid.scrollTo({ left: i * step, behavior: 'smooth' });
      });
    });

    let rafId;
    function onScroll() {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(function() {
        updateDots();
        updateArrows();
      });
    }

    grid.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function() {
      updateDots();
      updateArrows();
    });

    updateDots();
    updateArrows();
  })();
</script>

{% schema %}
{
  "name": "Collection Hover Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Section content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular Categories" },
    {
      "type": "select",
      "id": "heading_align",
