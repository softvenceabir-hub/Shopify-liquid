{% comment %}
  Custom Collection Hover Section (Dynamic Controls + Responsive Corner Arrows)
  - Grid / Horizontal Scroll layout switch
  - Dynamic slider controls: Dots only / Arrows only / Dots + Arrows / None
  - Dots sit top-center above the track
  - Arrows sit near image-row corners (desktop + mobile), slightly outside
  - Hidden native scrollbar
  - Section width controls (% and px)
  - Desktop/Mobile padding controls
  - Desktop/Mobile typography controls
  - Text transform controls
  - Circle hover expands to fill card on hover
{% endcomment %}

{%- liquid
  assign sec_id = section.id
  assign is_scroll = false
  if section.settings.layout_mode == 'scroll'
    assign is_scroll = true
  endif
  assign show_controls       = false
  assign show_dots_overlay   = false
  assign show_arrows_overlay = false
  if is_scroll and section.blocks.size > 1
    if section.settings.slider_controls_mode == 'dots'
      assign show_controls     = true
      assign show_dots_overlay = true
    elsif section.settings.slider_controls_mode == 'arrows'
      assign show_controls       = true
      assign show_arrows_overlay = true
    elsif section.settings.slider_controls_mode == 'both'
      assign show_controls       = true
      assign show_dots_overlay   = true
      assign show_arrows_overlay = true
    endif
  endif
-%}

{%- comment -%}======================== STYLES ========================{%- endcomment -%}
<style>
  /* ── Outer section ── */
  #cc-section-{{ sec_id }} {
    background:     {{ section.settings.section_bg }};
    padding-top:    {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    padding-left:   {{ section.settings.padding_left_desktop }}px;
    padding-right:  {{ section.settings.padding_right_desktop }}px;
  }

  /* ── Centred inner wrapper ── */
  #cc-section-{{ sec_id }} .cc-inner {
    {% if section.settings.width_mode == 'percent' %}
      width: {{ section.settings.section_width_percent }}%;
      max-width: {{ section.settings.section_max_width_px }}px;
    {% else %}
      width: 100%;
      max-width: {{ section.settings.section_max_width_px }}px;
    {% endif %}
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Section heading ── */
  #cc-section-{{ sec_id }} .cc-heading {
    text-align:     {{ section.settings.heading_align }};
    color:          {{ section.settings.heading_color }};
    font-size:      {{ section.settings.heading_size_desktop }}px;
    font-weight:    {{ section.settings.heading_weight }};
    text-transform: {{ section.settings.heading_transform }};
    margin: 0 0 20px;
    line-height: 1.2;
  }

  /* ── Dots ── */
  #cc-section-{{ sec_id }} .cc-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  #cc-section-{{ sec_id }} .cc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ccc;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    transition: background .2s, transform .2s;
  }
  #cc-section-{{ sec_id }} .cc-dot.is-active {
    background: #333;
    transform: scale(1.35);
  }

  /* ── Track wrapper — needed for absolute arrow positioning ── */
  #cc-section-{{ sec_id }} .cc-track-wrapper {
    position: relative;
  }

  /* ── Arrow overlay ── */
  #cc-section-{{ sec_id }} .cc-arrows {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: {{ section.settings.card_height_desktop }}px;
    pointer-events: none;
    z-index: 10;
  }
  #cc-section-{{ sec_id }} .cc-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: all;
    background: rgba(255,255,255,.92);
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(0,0,0,.14);
    color: #333;
    user-select: none;
    padding: 0;
    transition: background .2s, opacity .2s;
  }
  #cc-section-{{ sec_id }} .cc-arrow:hover { background: #fff; }
  #cc-section-{{ sec_id }} .cc-arrow[disabled] {
    opacity: .3;
    pointer-events: none;
  }
  /* Sit slightly outside the track edge */
  #cc-section-{{ sec_id }} .cc-arrow--prev { left:  -20px; }
  #cc-section-{{ sec_id }} .cc-arrow--next { right: -20px; }

  /* ── GRID layout ── */
  #cc-section-{{ sec_id }} .cc-track--grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap_desktop }}px;
  }

  /* ── SCROLL layout ── */
  #cc-section-{{ sec_id }} .cc-track--scroll {
    display: flex;
    gap: {{ section.settings.grid_gap_desktop }}px;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #cc-section-{{ sec_id }} .cc-track--scroll::-webkit-scrollbar { display: none; }

  #cc-section-{{ sec_id }} .cc-track--scroll .cc-card {
    flex: 0 0 calc(
      (100% - ({{ section.settings.scroll_items_desktop | minus: 1 }} * {{ section.settings.grid_gap_desktop }}px))
      / {{ section.settings.scroll_items_desktop }}
    );
    scroll-snap-align: start;
  }

  /* ── Card base ── */
  #cc-section-{{ sec_id }} .cc-card {
    position: relative;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    cursor: pointer;
    text-align: {{ section.settings.text_align }};
    min-height: {{ section.settings.card_height_desktop }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  /* ── Circle – expands to fill card on hover ── */
  #cc-section-{{ sec_id }} .cc-card__circle {
    position: absolute;
    width: {{ section.settings.circle_size_desktop }}px;
    height: {{ section.settings.circle_size_desktop }}px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    transition: transform .55s cubic-bezier(.4,0,.2,1), border-radius .55s ease;
    z-index: 0;
    pointer-events: none;
  }
  #cc-section-{{ sec_id }} .cc-card:hover .cc-card__circle,
  #cc-section-{{ sec_id }} .cc-card:focus-within .cc-card__circle {
    transform: translate(-50%, -50%) scale(10);
    border-radius: 0;
  }

  /* ── Image wrapper ── */
  #cc-section-{{ sec_id }} .cc-card__img-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-height: {{ section.settings.image_max_height_desktop }}px;
    overflow: visible;
    flex-shrink: 0;
  }
  #cc-section-{{ sec_id }} .cc-card__img {
    display: block;
    max-height: {{ section.settings.image_max_height_desktop }}px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    transition: transform .4s ease;
  }
  #cc-section-{{ sec_id }} .cc-card:hover .cc-card__img,
  #cc-section-{{ sec_id }} .cc-card:focus-within .cc-card__img {
    transform: scale(1.06);
  }

  /* ── Placeholder SVG ── */
  #cc-section-{{ sec_id }} .cc-card__placeholder {
    position: relative;
    z-index: 1;
    width: {{ section.settings.circle_size_desktop }}px;
    height: {{ section.settings.image_max_height_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #cc-section-{{ sec_id }} .cc-card__placeholder svg {
    width: 80px;
    height: 80px;
    opacity: .3;
  }

  /* ── Hover label badge ── */
  #cc-section-{{ sec_id }} .cc-card__hover-label {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,.52);
    color: #fff;
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 3px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity .3s;
    z-index: 3;
    pointer-events: none;
  }
  #cc-section-{{ sec_id }} .cc-card:hover .cc-card__hover-label { opacity: 1; }

  /* ── Card body (title + subtitle) ── */
  #cc-section-{{ sec_id }} .cc-card__body {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 10px 10px 6px;
    flex-shrink: 0;
  }
  #cc-section-{{ sec_id }} .cc-card__title {
    color:          {{ section.settings.title_color }};
    font-size:      {{ section.settings.title_size_desktop }}px;
    font-weight:    {{ section.settings.title_weight }};
    text-transform: {{ section.settings.title_transform }};
    margin: 0 0 4px;
    line-height: 1.2;
  }
  #cc-section-{{ sec_id }} .cc-card__subtitle {
    color:          {{ section.settings.subtitle_color }};
    font-size:      {{ section.settings.subtitle_size_desktop }}px;
    font-weight:    {{ section.settings.subtitle_weight }};
    text-transform: {{ section.settings.subtitle_transform }};
    margin: 0;
    line-height: 1.3;
  }

  /* ════════════════ MOBILE ════════════════ */
  @media (max-width: 768px) {
    #cc-section-{{ sec_id }} {
      padding-top:    {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left:   {{ section.settings.padding_left_mobile }}px;
      padding-right:  {{ section.settings.padding_right_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-track--grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-track--scroll {
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-track--scroll .cc-card {
      flex: 0 0 calc(
        (100% - ({{ section.settings.scroll_items_mobile_num | minus: 1 }} * {{ section.settings.grid_gap_mobile }}px))
        / {{ section.settings.scroll_items_mobile_num }}
      );
    }
    #cc-section-{{ sec_id }} .cc-card {
      min-height: {{ section.settings.card_height_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-arrows {
      height: {{ section.settings.card_height_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-arrow {
      width: 32px;
      height: 32px;
      font-size: 18px;
    }
    #cc-section-{{ sec_id }} .cc-arrow--prev { left:  -10px; }
    #cc-section-{{ sec_id }} .cc-arrow--next { right: -10px; }
    #cc-section-{{ sec_id }} .cc-card__circle {
      width:  {{ section.settings.circle_size_mobile }}px;
      height: {{ section.settings.circle_size_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-card__img-wrap {
      max-height: {{ section.settings.image_max_height_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-card__img {
      max-height: {{ section.settings.image_max_height_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-card__placeholder {
      width:  {{ section.settings.circle_size_mobile }}px;
      height: {{ section.settings.image_max_height_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-card__title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
    #cc-section-{{ sec_id }} .cc-card__subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }
    {%- if section.settings.hide_hover_label_mobile -%}
    #cc-section-{{ sec_id }} .cc-card__hover-label { display: none; }
    {%- endif -%}
  }
</style>

{%- comment -%}======================== HTML ========================{%- endcomment -%}
<section id="cc-section-{{ sec_id }}" class="cc-section">
  <div class="cc-inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="cc-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%} Dots (rendered above the track) {%- endcomment -%}
    {%- if show_dots_overlay -%}
      <div class="cc-dots" data-cc-dots="{{ sec_id }}" role="tablist" aria-label="Slider navigation">
        {%- for block in section.blocks -%}
          <button
            class="cc-dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            role="tab"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="cc-track-wrapper">

      {%- comment -%} Arrows (absolutely positioned over the track) {%- endcomment -%}
      {%- if show_arrows_overlay -%}
        <div class="cc-arrows" aria-hidden="true">
          <button
            class="cc-arrow cc-arrow--prev"
            data-cc-dir="prev"
            data-cc-track="{{ sec_id }}"
            aria-label="Previous"
            disabled
          >&#8249;</button>
          <button
            class="cc-arrow cc-arrow--next"
            data-cc-dir="next"
            data-cc-track="{{ sec_id }}"
            aria-label="Next"
          >&#8250;</button>
        </div>
      {%- endif -%}

      {%- comment -%} Card track {%- endcomment -%}
      <div
        id="cc-track-{{ sec_id }}"
        class="cc-track cc-track--{{ section.settings.layout_mode }}"
        {% if is_scroll %}data-cc-scroll="true"{% endif %}
      >

        {%- for block in section.blocks -%}
          {%- liquid
            assign card_title    = block.settings.title
            assign card_subtitle = block.settings.subtitle
            assign card_link     = block.settings.link
            assign has_link      = false
            if card_link != blank
              assign has_link = true
            endif
          -%}

          {%- if has_link -%}
            <a
              href="{{ card_link }}"
              class="cc-card"
              {{ block.shopify_attributes }}
              aria-label="{{ card_title }}"
            >
          {%- else -%}
            <div class="cc-card" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- comment -%} Animated circle — expands on hover to fill the card {%- endcomment -%}
            <span
              class="cc-card__circle"
              style="background:{{ block.settings.circle_bg }};"
              aria-hidden="true"
            ></span>

            {%- comment -%} Image {%- endcomment -%}
            <div class="cc-card__img-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'cc-card__img',
                    loading: 'lazy',
                    widths: '240,360,480,720,900',
                    sizes: '(max-width: 768px) 90vw, (max-width: 1200px) 33vw, 400px',
                    alt: card_title
                }}
              {%- else -%}
                <div class="cc-card__placeholder" aria-hidden="true">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} Optional hover badge {%- endcomment -%}
            {%- if section.settings.show_hover_label -%}
              <span class="cc-card__hover-label" aria-hidden="true">
                {{ section.settings.hover_label_text }}
              </span>
            {%- endif -%}

            {%- comment -%} Title & Subtitle {%- endcomment -%}
            {%- if card_title != blank or card_subtitle != blank -%}
              <div class="cc-card__body">
                {%- if card_title != blank -%}
                  <p class="cc-card__title">{{ card_title }}</p>
                {%- endif -%}
                {%- if card_subtitle != blank -%}
                  <p class="cc-card__subtitle">{{ card_subtitle }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- if has_link -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}

        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

{%- comment -%}======================== JAVASCRIPT ========================{%- endcomment -%}
<script>
(function () {
  'use strict';

  var SEC  = '{{ sec_id }}';
  var track = document.getElementById('cc-track-' + SEC);
  if (!track) return;

  var isScroll = track.dataset.ccScroll === 'true';
  if (!isScroll) return;

  /* ── Element references ── */
  var dotsWrap  = document.querySelector('[data-cc-dots="' + SEC + '"]');
  var dots      = dotsWrap ? Array.from(dotsWrap.querySelectorAll('.cc-dot')) : [];
  var btnPrev   = document.querySelector('.cc-arrow--prev[data-cc-track="' + SEC + '"]');
  var btnNext   = document.querySelector('.cc-arrow--next[data-cc-track="' + SEC + '"]');

  /* ── Get all card elements ── */
  function getCards() {
    return Array.from(track.querySelectorAll('.cc-card'));
  }

  /* ── Width of one card + gap (the scroll step) ── */
  function stepWidth() {
    var c = getCards();
    if (!c.length) return 0;
    var gap = parseFloat(getComputedStyle(track).gap) || 0;
    return c[0].offsetWidth + gap;
  }

  /* ── Index of the nearest card to the current scroll position ── */
  function nearestIndex() {
    var step = stepWidth();
    return step ? Math.round(track.scrollLeft / step) : 0;
  }

  /* ── Animate-scroll to an index ── */
  function goTo(idx) {
    var cards = getCards();
    var step  = stepWidth();
    if (!cards.length || !step) return;
    idx = Math.max(0, Math.min(idx, cards.length - 1));
    track.scrollTo({ left: idx * step, behavior: 'smooth' });
  }

  /* ── Sync dots ── */
  function syncDots(idx) {
    dots.forEach(function (d, i) {
      var active = i === idx;
      d.classList.toggle('is-active', active);
      d.setAttribute('aria-selected', String(active));
    });
  }

  /* ── Sync arrow disabled state ── */
  function syncArrows(idx) {
    var last = getCards().length - 1;
    if (btnPrev) btnPrev.disabled = idx <= 0;
    if (btnNext) btnNext.disabled = idx >= last;
  }

  /* ── Combined sync call ── */
  function sync() {
    var idx = nearestIndex();
    syncDots(idx);
    syncArrows(idx);
  }

  /* ── Wire up dot clicks ── */
  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      goTo(parseInt(this.dataset.index, 10));
    });
  });

  /* ── Wire up arrow clicks ── */
  if (btnPrev) btnPrev.addEventListener('click', function () { goTo(nearestIndex() - 1); });
  if (btnNext) btnNext.addEventListener('click', function () { goTo(nearestIndex() + 1); });

  /* ── Keep controls in sync while scrolling ── */
  track.addEventListener('scroll',        sync, { passive: true });
  window.addEventListener('resize',       sync, { passive: true });

  /* ── Initial state ── */
  sync();

})();
</script>

