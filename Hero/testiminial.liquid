{% comment %}
  Testimonials with Infinite Carousel - Shopify
  Automatically becomes carousel when more than 3 testimonials
{% endcomment %}

{{ 'component-testimonials.css' | asset_url | stylesheet_tag }}

<style>
  /* Dynamic CSS from settings */
  .testimonials-section {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    padding-left: {{ section.settings.section_padding_left }}px;
    padding-right: {{ section.settings.section_padding_right }}px;
    background-color: {{ section.settings.section_background }};
    overflow: hidden;
  }

  .testimonials-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    text-align: {{ section.settings.title_alignment }};
  }

  .testimonials-title::after {
    background-color: {{ section.settings.title_underline_color }};
    width: {{ section.settings.title_underline_width }}px;
    height: {{ section.settings.title_underline_height }}px;
  }

  .testimonials-subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_font_size }}px;
    text-align: {{ section.settings.subtitle_alignment }};
  }

  .testimonial-card {
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    width: {{ section.settings.card_width }}px;
    box-shadow: {{ section.settings.card_shadow }};
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .testimonial-image {
    width: {{ section.settings.image_width }}px;
    height: {{ section.settings.image_height }}px;
    border-radius: {{ section.settings.image_border_radius }}%;
    border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
  }

  .testimonial-text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_font_size }}px;
    line-height: {{ section.settings.text_line_height }};
    text-align: {{ section.settings.text_alignment }};
  }

  .testimonial-name {
    color: {{ section.settings.name_color }};
    font-size: {{ section.settings.name_font_size }}px;
    font-weight: {{ section.settings.name_font_weight }};
  }

  .testimonial-position {
    color: {{ section.settings.position_color }};
    font-size: {{ section.settings.position_font_size }}px;
  }

  .testimonial-quote {
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.quote_font_size }}px;
  }

  /* Grid Layout (for 3 or fewer testimonials) */
  .testimonials-grid {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.card_gap }}px;
    justify-content: {{ section.settings.card_alignment }};
    transition: all 0.3s ease;
  }

  /* Carousel Layout (for more than 3 testimonials) */
  .testimonials-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .testimonials-carousel-track {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    transition: transform 0.5s ease-in-out;
    will-change: transform;
  }

  .carousel-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .carousel-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: {{ section.settings.carousel_btn_bg }};
    color: {{ section.settings.carousel_btn_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: all 0.3s ease;
  }

  .carousel-btn:hover {
    background-color: {{ section.settings.carousel_btn_bg_hover }};
    transform: scale(1.1);
  }

  .carousel-dots {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .carousel-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ section.settings.carousel_dot_inactive }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .carousel-dot.active {
    background-color: {{ section.settings.carousel_dot_active }};
    transform: scale(1.2);
  }

  .carousel-arrow {
    font-size: 24px;
    font-weight: bold;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .testimonials-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    
    .testimonial-card {
      width: 280px;
      min-width: 280px;
    }
    
    .carousel-btn {
      width: 40px;
      height: 40px;
      font-size: 16px;
    }
    
    .carousel-dot {
      width: 10px;
      height: 10px;
    }
  }

  @media (max-width: 480px) {
    .testimonial-card {
      width: 250px;
      min-width: 250px;
    }
  }
</style>

<section class="testimonials-section" id="testimonials-{{ section.id }}">
  <div class="testimonials-container" style="max-width: {{ section.settings.section_max_width }}px; margin: 0 auto;">
    
    <!-- Header Section -->
    <div class="testimonials-header" style="margin-bottom: {{ section.settings.header_margin_bottom }}px;">
      {% if section.settings.title != blank %}
        <h2 class="testimonials-title">
          {{ section.settings.title }}
        </h2>
      {% endif %}
      
      {% if section.settings.subtitle != blank %}
        <p class="testimonials-subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    <!-- Testimonials Container -->
    {% if section.blocks.size > 3 %}
      <!-- Carousel for more than 3 testimonials -->
      <div class="testimonials-carousel">
        <div class="testimonials-carousel-track" id="carousel-track-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="testimonial-card" {{ block.shopify_attributes }}
                 style="transition: transform 0.3s ease, box-shadow 0.3s ease;"
                 onmouseover="this.style.transform='translateY(-{{ section.settings.card_hover_lift }}px)';"
                 onmouseout="this.style.transform='translateY(0)';">
              
              <!-- Image -->
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" 
                     alt="{{ block.settings.name | escape }}" 
                     class="testimonial-image"
                     loading="lazy">
              {% else %}
                <div class="testimonial-image-placeholder" style="
                  width: {{ section.settings.image_width }}px;
                  height: {{ section.settings.image_height }}px;
                  border-radius: {{ section.settings.image_border_radius }}%;
                  background-color: #f0f0f0;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #999;
                  font-size: 14px;
                  margin-bottom: 20px;
                ">
                  No Image
                </div>
              {% endif %}

              <!-- Quote Icon -->
              <p class="testimonial-quote" style="margin: 0 0 15px 0; line-height: 1;">"</p>

              <!-- Testimonial Text -->
              <p class="testimonial-text" style="margin: 0 0 20px 0;">
                {{ block.settings.testimonial_text }}
              </p>

              <!-- Author Info -->
              <div class="testimonial-author" style="margin-top: auto; text-align: center;">
                <h3 class="testimonial-name" style="margin: 0 0 5px 0;">
                  {{ block.settings.name }}
                </h3>
                {% if block.settings.position != blank %}
                  <p class="testimonial-position" style="margin: 0; opacity: 0.8;">
                    {{ block.settings.position }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Carousel Navigation -->
        <div class="carousel-nav">
          <button class="carousel-btn prev-btn" id="prev-btn-{{ section.id }}">
            <span class="carousel-arrow">‹</span>
          </button>
          
          <div class="carousel-dots" id="dots-container-{{ section.id }}">
            {% for i in (1..section.blocks.size) %}
              <button class="carousel-dot {% if forloop.first %}active{% endif %}" 
                      data-index="{{ forloop.index0 }}"></button>
            {% endfor %}
          </div>
          
          <button class="carousel-btn next-btn" id="next-btn-{{ section.id }}">
            <span class="carousel-arrow">›</span>
          </button>
        </div>
      </div>

    {% else %}
      <!-- Grid for 3 or fewer testimonials -->
      <div class="testimonials-grid">
        {% for block in section.blocks %}
          <div class="testimonial-card" {{ block.shopify_attributes }}
               style="transition: transform 0.3s ease, box-shadow 0.3s ease;"
               onmouseover="this.style.transform='translateY(-{{ section.settings.card_hover_lift }}px)';"
               onmouseout="this.style.transform='translateY(0)';">
            
            <!-- Image -->
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" 
                   alt="{{ block.settings.name | escape }}" 
                   class="testimonial-image"
                   loading="lazy">
            {% else %}
              <div class="testimonial-image-placeholder" style="
                width: {{ section.settings.image_width }}px;
                height: {{ section.settings.image_height }}px;
                border-radius: {{ section.settings.image_border_radius }}%;
                background-color: #f0f0f0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #999;
                font-size: 14px;
                margin-bottom: 20px;
              ">
                No Image
              </div>
            {% endif %}

            <!-- Quote Icon -->
            <p class="testimonial-quote" style="margin: 0 0 15px 0; line-height: 1;">"</p>

            <!-- Testimonial Text -->
            <p class="testimonial-text" style="margin: 0 0 20px 0;">
              {{ block.settings.testimonial_text }}
            </p>

            <!-- Author Info -->
            <div class="testimonial-author" style="margin-top: auto; text-align: center;">
              <h3 class="testimonial-name" style="margin: 0 0 5px 0;">
                {{ block.settings.name }}
              </h3>
              {% if block.settings.position != blank %}
                <p class="testimonial-position" style="margin: 0; opacity: 0.8;">
                  {{ block.settings.position }}
                </p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const testimonialBlocks = {{ section.blocks.size }};
  
  // Only initialize carousel if more than 3 testimonials
  if (testimonialBlocks > 3) {
    initCarousel(sectionId);
  }
  
  function initCarousel(sectionId) {
    const carouselTrack = document.getElementById(`carousel-track-${sectionId}`);
    const prevBtn = document.getElementById(`prev-btn-${sectionId}`);
    const nextBtn = document.getElementById(`next-btn-${sectionId}`);
    const dotsContainer = document.getElementById(`dots-container-${sectionId}`);
    
    if (!carouselTrack) return;
    
    // Get all original cards
    const originalCards = Array.from(carouselTrack.children);
    const totalSlides = originalCards.length;
    
    if (totalSlides === 0) return;
    
    // Clone all cards and append them for infinite loop
    originalCards.forEach(card => {
      const clone = card.cloneNode(true);
      carouselTrack.appendChild(clone);
    });
    
    // Clone again and prepend for backward infinite loop
    originalCards.forEach(card => {
      const clone = card.cloneNode(true);
      carouselTrack.insertBefore(clone, carouselTrack.firstChild);
    });
    
    const allCards = carouselTrack.querySelectorAll('.testimonial-card');
    let currentIndex = totalSlides; // Start at the first set of real cards
    let isTransitioning = false;
    
    function getCardWidth() {
      return allCards[0].offsetWidth + (parseInt(getComputedStyle(carouselTrack).gap) || 30);
    }
    
    // Set initial position
    function setInitialPosition() {
      carouselTrack.style.transition = 'none';
      carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
      setTimeout(() => {
        carouselTrack.style.transition = 'transform 0.5s ease-in-out';
      }, 50);
    }
    
    setInitialPosition();
    updateDots();
    
    // Handle transition end for infinite loop
    function handleTransitionEnd() {
      if (currentIndex >= totalSlides * 2) {
        carouselTrack.style.transition = 'none';
        currentIndex = totalSlides;
        carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
        setTimeout(() => {
          carouselTrack.style.transition = 'transform 0.5s ease-in-out';
        }, 50);
      } else if (currentIndex < totalSlides) {
        carouselTrack.style.transition = 'none';
        currentIndex = totalSlides * 2 - 1;
        carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
        setTimeout(() => {
          carouselTrack.style.transition = 'transform 0.5s ease-in-out';
        }, 50);
      }
      isTransitioning = false;
    }
    
    carouselTrack.addEventListener('transitionend', handleTransitionEnd);
    
    // Next button
    function moveNext() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex++;
      carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
      updateDots();
    }
    
    // Previous button
    function movePrev() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex--;
      carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
      updateDots();
    }
    
    nextBtn.addEventListener('click', moveNext);
    prevBtn.addEventListener('click', movePrev);
    
    // Dot navigation
    if (dotsContainer) {
      dotsContainer.addEventListener('click', (e) => {
        if (e.target.classList.contains('carousel-dot') && !isTransitioning) {
          isTransitioning = true;
          const targetIndex = parseInt(e.target.dataset.index);
          currentIndex = totalSlides + targetIndex;
          carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
          updateDots();
        }
      });
    }
    
    // Update dots
    function updateDots() {
      if (!dotsContainer) return;
      const dots = dotsContainer.querySelectorAll('.carousel-dot');
      const realIndex = (currentIndex - totalSlides + totalSlides) % totalSlides;
      
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === realIndex);
      });
    }
    
    // Auto slide
    {% if section.settings.auto_slide %}
    let autoSlideInterval = setInterval(moveNext, {{ section.settings.auto_slide_interval | default: 5000 }});
    
    carouselTrack.addEventListener('mouseenter', () => {
      clearInterval(autoSlideInterval);
    });
    
    carouselTrack.addEventListener('mouseleave', () => {
      autoSlideInterval = setInterval(moveNext, {{ section.settings.auto_slide_interval | default: 5000 }});
    });
    {% endif %}
    
    // Handle resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        carouselTrack.style.transition = 'none';
        carouselTrack.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
        setTimeout(() => {
          carouselTrack.style.transition = 'transform 0.5s ease-in-out';
        }, 50);
      }, 250);
    });
  }
});
</script>


