{% comment %}
  Products Marquee Section — Seamless infinite scroll (JS clone approach)
{% endcomment %}

{% assign gap = section.settings.item_gap %}
{% assign speed = section.settings.marquee_speed %}

<style>
  #marquee-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.desktop_padding_top }}px;
    --section-padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    --item-gap: {{ gap }}px;
    --duration: {{ speed }}s;
    background: {{ section.settings.section_bg }};
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    overflow: hidden;
  }

  #marquee-section-{{ section.id }} .marquee-heading {
    text-align: {{ section.settings.heading_align }};
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    text-transform: {{ section.settings.heading_transform }};
    letter-spacing: {{ section.settings.heading_letter_spacing | times: 0.01 }}em;
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    width: {{ section.settings.section_width }}%;
    margin-left: auto;
    margin-right: auto;
  }

  #marquee-section-{{ section.id }} .marquee-outer {
    width: 100%;
    overflow: hidden;
  }

  #marquee-section-{{ section.id }} .marquee-track {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    gap: var(--item-gap);
    will-change: transform;
  }

  /* ── Item ── */
  #marquee-section-{{ section.id }} .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    background: {{ section.settings.item_bg }};
    color: {{ section.settings.item_text_color }};
    padding: {{ section.settings.item_padding_v }}px {{ section.settings.item_padding_h }}px {{ section.settings.item_padding_v }}px {{ section.settings.item_padding_img }}px;
    border-radius: {{ section.settings.border_radius }}px;
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    font-size: {{ section.settings.desktop_label_size }}px;
    font-weight: {{ section.settings.label_weight }};
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  #marquee-section-{{ section.id }} .marquee-item:hover {
    background: {{ section.settings.hover_bg }};
    color: {{ section.settings.hover_text_color }};
    border-color: {{ section.settings.hover_border_color }};
  }

  /* ── Image ── */
  #marquee-section-{{ section.id }} .marquee-item__img,
  #marquee-section-{{ section.id }} .marquee-item__img-placeholder {
    width: {{ section.settings.image_size }}px;
    height: {{ section.settings.image_size }}px;
    border-radius: {{ section.settings.image_radius }}px;
    object-fit: cover;
    flex-shrink: 0;
    display: block;
    background: {{ section.settings.img_bg }};
  }

  #marquee-section-{{ section.id }} .marquee-item__img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    #marquee-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      --item-gap: {{ section.settings.item_gap_mobile }}px;
    }
    #marquee-section-{{ section.id }} .marquee-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      width: {{ section.settings.mobile_section_width }}%;
    }
    #marquee-section-{{ section.id }} .marquee-item,
    #marquee-section-{{ section.id }} .marquee-item__label {
      font-size: {{ section.settings.mobile_label_size }}px;
    }
  }
</style>

<section
  id="marquee-section-{{ section.id }}"
  data-section-type="products-marquee"
  data-section-id="{{ section.id }}"
>
  {% if section.settings.heading != blank %}
    <h2 class="marquee-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="marquee-outer">
    <div
      class="marquee-track"
      id="marquee-track-{{ section.id }}"
      data-speed="{{ speed }}"
      data-direction="{{ section.settings.marquee_direction }}"
    >
      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          {% assign lp         = all_products[block.settings.product] %}
          {% assign item_url   = lp.url %}
          {% assign item_image = lp.featured_image %}
          {% assign item_label = block.settings.label | default: lp.title %}
        {% else %}
          {% assign item_url   = block.settings.custom_url | default: '#' %}
          {% assign item_image = block.settings.custom_image %}
          {% assign item_label = block.settings.label | default: 'Product Name' %}
        {% endif %}

        <a href="{{ item_url }}" class="marquee-item" {{ block.shopify_attributes }}>
          {% if item_image != blank %}
            <img
              class="marquee-item__img"
              src="{{ item_image | image_url: width: 120 }}"
              alt="{{ item_label | escape }}"
              width="{{ section.settings.image_size }}"
              height="{{ section.settings.image_size }}"
              loading="lazy"
            >
          {% else %}
            <span class="marquee-item__img-placeholder">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.35">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </span>
          {% endif %}
          <span class="marquee-item__label">{{ item_label }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function () {
  /**
   * ProductsMarquee — requestAnimationFrame infinite scroll
   *
   * Logic (same as scrolling-promotion.js pattern):
   * 1. Read original items from the track.
   * 2. Clone them enough times to fill viewport × 2+ so there's
   *    always off-screen content ready to appear.
   * 3. On every rAF tick, move offset by (oneSetWidth / speed / 60fps) px.
   * 4. When offset reaches ±oneSetWidth, reset silently — identical
   *    clone makes the jump invisible.
   * 5. Pause on hover and on tab-hidden.
   */

  class ProductsMarquee {
    constructor(sectionId) {
      this.id        = sectionId;
      this.section   = document.getElementById('marquee-section-' + sectionId);
      this.track     = document.getElementById('marquee-track-'   + sectionId);

      if (!this.section || !this.track) return;

      this.speed     = parseFloat(this.track.dataset.speed)     || 30;
      this.direction = this.track.dataset.direction             || 'left';
      this.paused    = false;
      this.raf       = null;
      this.offset    = 0;
      this.oneSetW   = 0;

      this._init();
    }

    /* ── helpers ─────────────────────────────── */
    _gap() {
      return parseFloat(getComputedStyle(this.section).getPropertyValue('--item-gap')) || 16;
    }

    /* ── setup ───────────────────────────────── */
    _init() {
      // snapshot original items BEFORE cloning
      this.originals = Array.from(this.track.children);
      this._fillClones();
      this._measure();
      this._bindEvents();
      requestAnimationFrame(this._tick.bind(this));
    }

    _fillClones() {
      const viewportW = window.innerWidth;
      // How many extra sets do we need?
      // Estimate: each item ~160px, so total set ≈ originals.length * 160
      const estimate = Math.max(this.originals.length * 160, 1);
      const copies   = Math.max(2, Math.ceil((viewportW * 3) / estimate));

      for (let c = 0; c < copies; c++) {
        this.originals.forEach(item => {
          const clone = item.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelectorAll('a, button').forEach(el => {
            el.setAttribute('tabindex', '-1');
          });
          this.track.appendChild(clone);
        });
      }
    }

    _measure() {
      const gap = this._gap();
      let w = 0;
      this.originals.forEach((item, i) => {
        w += item.getBoundingClientRect().width;
        if (i < this.originals.length - 1) w += gap;
      });
      // include the trailing gap before the next copy starts
      this.oneSetW = w + gap;

      // right direction starts pre-offset so it scrolls rightward
      if (this.direction === 'right') {
        this.offset = -this.oneSetW;
      } else {
        this.offset = 0;
      }
      this.track.style.transform = 'translateX(' + this.offset + 'px)';
    }

    /* ── events ──────────────────────────────── */
    _bindEvents() {
      this.section.addEventListener('mouseenter', () => { this.paused = true;  });
      this.section.addEventListener('mouseleave', () => { this.paused = false; });

      document.addEventListener('visibilitychange', () => {
        this.paused = document.hidden;
      });

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => { this._measure(); }, 200);
      });
    }

    /* ── animation loop ──────────────────────── */
    _tick() {
      if (!this.paused) {
        // px moved per frame at 60 fps
        const step = this.oneSetW / (this.speed * 60);

        if (this.direction === 'left') {
          this.offset -= step;
          if (this.offset <= -this.oneSetW) this.offset += this.oneSetW;
        } else {
          this.offset += step;
          if (this.offset >= 0) this.offset -= this.oneSetW;
        }

        this.track.style.transform = 'translateX(' + this.offset + 'px)';
      }
      requestAnimationFrame(this._tick.bind(this));
    }
  }

  /* ── Boot ────────────────────────────────────── */
  function boot() {
    new ProductsMarquee('{{ section.id }}');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  // Shopify Theme Editor live-reload support
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail.sectionId === '{{ section.id }}') boot();
  });
})();
</script>


{% schema %}
{
  "name": "Products Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "── Heading" },
    { "type": "text", "id": "heading", "label": "Heading Text", "default": "OUR PRODUCTS" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#1a1a1a" },
    {
      "type": "select", "id": "heading_align", "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "desktop_heading_size", "label": "Heading Size — Desktop (px)", "min": 12, "max": 80, "step": 1, "default": 26 },
    { "type": "range", "id": "mobile_heading_size",  "label": "Heading Size — Mobile (px)",  "min": 12, "max": 60, "step": 1, "default": 18 },
    {
      "type": "select", "id": "heading_weight", "label": "Heading Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "600"
    },
    {
      "type": "select", "id": "heading_transform", "label": "Heading Text Case",
      "options": [
        { "value": "none",       "label": "None" },
        { "value": "uppercase",  "label": "UPPERCASE" },
        { "value": "lowercase",  "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading Letter Spacing",    "min": 0, "max": 50, "step": 1,  "default": 10, "info": "10 = 0.10em" },
    { "type": "range", "id": "heading_margin_bottom",  "label": "Heading Bottom Space (px)", "min": 0, "max": 80, "step": 2,  "default": 28 },

    { "type": "header", "content": "── Section Layout" },
    { "type": "color",  "id": "section_bg",             "label": "Section Background",             "default": "#ffffff" },
    { "type": "range",  "id": "section_width",           "label": "Section Width — Desktop (%)",   "min": 50, "max": 100, "step": 1, "default": 90 },
    { "type": "range",  "id": "mobile_section_width",    "label": "Section Width — Mobile (%)",    "min": 50, "max": 100, "step": 1, "default": 100 },
    { "type": "range",  "id": "desktop_padding_top",     "label": "Padding Top — Desktop (px)",    "min": 0,  "max": 120, "step": 4, "default": 48 },
    { "type": "range",  "id": "desktop_padding_bottom",  "label": "Padding Bottom — Desktop (px)", "min": 0,  "max": 120, "step": 4, "default": 48 },
    { "type": "range",  "id": "mobile_padding_top",      "label": "Padding Top — Mobile (px)",     "min": 0,  "max": 80,  "step": 4, "default": 28 },
    { "type": "range",  "id": "mobile_padding_bottom",   "label": "Padding Bottom — Mobile (px)",  "min": 0,  "max": 80,  "step": 4, "default": 28 },
    {
      "type": "select", "id": "marquee_direction", "label": "Scroll Direction",
      "options": [
        { "value": "left",  "label": "← Left (default)" },
        { "value": "right", "label": "→ Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "marquee_speed",    "label": "Marquee Speed (sec, lower = faster)", "min": 5, "max": 80, "step": 1,  "default": 30 },
    { "type": "range", "id": "item_gap",         "label": "Gap Between Items — Desktop (px)",   "min": 4, "max": 60, "step": 2,  "default": 16 },
    { "type": "range", "id": "item_gap_mobile",  "label": "Gap Between Items — Mobile (px)",    "min": 4, "max": 40, "step": 2,  "default": 10 },

    { "type": "header", "content": "── Item Style" },
    { "type": "color", "id": "item_bg",          "label": "Item Background",      "default": "#ffffff" },
    { "type": "color", "id": "item_text_color",  "label": "Item Text Color",      "default": "#1a1a1a" },
    { "type": "range", "id": "desktop_label_size","label": "Label Size — Desktop (px)", "min": 10, "max": 32, "step": 1, "default": 15 },
    { "type": "range", "id": "mobile_label_size", "label": "Label Size — Mobile (px)",  "min": 10, "max": 24, "step": 1, "default": 13 },
    {
      "type": "select", "id": "label_weight", "label": "Label Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "item_padding_v",   "label": "Item Padding — Vertical (px)", "min": 4, "max": 32, "step": 1, "default": 10 },
    { "type": "range", "id": "item_padding_h",   "label": "Item Padding — Right (px)",    "min": 4, "max": 48, "step": 1, "default": 22 },
    { "type": "range", "id": "item_padding_img", "label": "Item Padding — Left (px)",     "min": 4, "max": 24, "step": 1, "default": 8  },

    { "type": "header", "content": "── Border & Radius" },
    { "type": "range", "id": "border_radius", "label": "Item Border Radius (px)", "min": 0, "max": 100, "step": 1, "default": 50 },
    { "type": "range", "id": "border_width",  "label": "Border Width (px)",       "min": 0, "max": 5,   "step": 1, "default": 1  },
    { "type": "color", "id": "border_color",  "label": "Border Color",            "default": "#e0c8c8" },

    { "type": "header", "content": "── Hover Style" },
    { "type": "color", "id": "hover_bg",           "label": "Hover Background",  "default": "#1a2e3b" },
    { "type": "color", "id": "hover_text_color",   "label": "Hover Text Color",  "default": "#ffffff" },
    { "type": "color", "id": "hover_border_color", "label": "Hover Border Color","default": "#1a2e3b" },

    { "type": "header", "content": "── Image" },
    { "type": "range", "id": "image_size",   "label": "Image Size (px)",          "min": 24,  "max": 100, "step": 2, "default": 52 },
    { "type": "range", "id": "image_radius", "label": "Image Border Radius (px)", "min": 0,   "max": 100, "step": 1, "default": 50 },
    { "type": "color", "id": "img_bg",       "label": "Image Background Color",   "default": "#f5f0eb" }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        { "type": "product",      "id": "product",      "label": "Select Product",           "info": "URL and image auto-loaded" },
        { "type": "text",         "id": "label",        "label": "Custom Label (optional)",  "info": "Leave blank to use product title" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom Image (optional)" },
        { "type": "url",          "id": "custom_url",   "label": "Custom URL (optional)",    "info": "Used only if no product selected" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products Marquee",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}
