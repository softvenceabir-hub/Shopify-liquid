{% comment %}
  Better Sleep Banner Section
  Fully customizable section with width, height, padding, colors, and hover effects
{% endcomment %}

<style>
  .better-sleep-section-{{ section.id }} {
    width: {{ section.settings.section_width }};
    max-width: 100%;
    margin: 0 auto;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_horizontal }}px {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
    position: relative;
    overflow: hidden;
  }

  .better-sleep-banner-{{ section.id }} {
    position: relative;
    height: {{ section.settings.banner_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ section.settings.banner_border_radius }}px;
    overflow: hidden;
  }

  .better-sleep-banner-{{ section.id }} .banner-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .better-sleep-banner-{{ section.id }} .banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .better-sleep-content-{{ section.id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: {{ section.settings.content_max_width }}px;
    padding: 0 20px;
  }

  .better-sleep-content-{{ section.id }} .heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  .better-sleep-content-{{ section.id }} .description {
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
    margin-bottom: {{ section.settings.description_margin_bottom }}px;
  }

  .better-sleep-cards-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ section.settings.card_gap }}px;
    margin-top: {{ section.settings.cards_margin_top }}px;
  }

  .sleep-card-{{ section.id }} {
    background-color: {{ section.settings.card_bg_color }};
    padding: {{ section.settings.card_padding }}px;
    border-radius: {{ section.settings.card_border_radius }}px;
    box-shadow: {{ section.settings.card_shadow }};
    transition: all {{ section.settings.hover_transition_speed }}ms ease;
    text-align: left;
    position: relative;
    overflow: hidden;
  }

  .sleep-card-{{ section.id }}::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: {{ section.settings.card_accent_height }}px;
    transition: all {{ section.settings.hover_transition_speed }}ms ease;
  }

  .sleep-card-{{ section.id }}:nth-child(1)::before {
    background-color: {{ section.settings.card_1_accent_color }};
  }

  .sleep-card-{{ section.id }}:nth-child(2)::before {
    background-color: {{ section.settings.card_2_accent_color }};
  }

  .sleep-card-{{ section.id }}:nth-child(3)::before {
    background-color: {{ section.settings.card_3_accent_color }};
  }

  .sleep-card-{{ section.id }}:nth-child(4)::before {
    background-color: {{ section.settings.card_4_accent_color }};
  }

  .sleep-card-{{ section.id }}:hover {
    transform: translateY({{ section.settings.hover_lift }}px) scale({{ section.settings.hover_scale | divided_by: 100.0 }});
    box-shadow: {{ section.settings.card_hover_shadow }};
    background-color: {{ section.settings.card_hover_bg_color }};
  }

  .sleep-card-{{ section.id }}:hover::before {
    height: {{ section.settings.card_accent_hover_height }}px;
  }

  .sleep-card-{{ section.id }} .card-icon {
    font-size: {{ section.settings.card_icon_size }}px;
    margin-bottom: {{ section.settings.card_icon_margin }}px;
  }

  .sleep-card-{{ section.id }} .card-title {
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: {{ section.settings.card_title_weight }};
    margin-bottom: {{ section.settings.card_title_margin }}px;
  }

  .sleep-card-{{ section.id }}:hover .card-title {
    color: {{ section.settings.card_title_hover_color }};
  }

  .sleep-card-{{ section.id }} .card-description {
    color: {{ section.settings.card_description_color }};
    font-size: {{ section.settings.card_description_size }}px;
    line-height: 1.5;
    margin-bottom: {{ section.settings.card_description_margin }}px;
  }

  .sleep-card-{{ section.id }}:hover .card-description {
    color: {{ section.settings.card_description_hover_color }};
  }

  .sleep-card-{{ section.id }} .card-link {
    color: {{ section.settings.card_link_color }};
    font-size: {{ section.settings.card_link_size }}px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all {{ section.settings.hover_transition_speed }}ms ease;
  }

  .sleep-card-{{ section.id }}:hover .card-link {
    color: {{ section.settings.card_link_hover_color }};
    gap: 12px;
  }

  .sleep-card-{{ section.id }} .card-link svg {
    width: 16px;
    height: 16px;
    transition: transform {{ section.settings.hover_transition_speed }}ms ease;
  }

  .sleep-card-{{ section.id }}:hover .card-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .better-sleep-banner-{{ section.id }} {
      height: {{ section.settings.banner_height_mobile }}px;
    }

    .better-sleep-content-{{ section.id }} .heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .better-sleep-content-{{ section.id }} .description {
      font-size: {{ section.settings.description_size_mobile }}px;
    }

    .better-sleep-cards-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="better-sleep-section-{{ section.id }}">
  <div class="better-sleep-banner-{{ section.id }}">
    {% if section.settings.banner_image %}
      <img 
        src="{{ section.settings.banner_image | img_url: '2000x' }}" 
        alt="{{ section.settings.banner_image.alt | escape }}"
        class="banner-image"
        loading="lazy"
      >
    {% endif %}
    
    <div class="banner-overlay"></div>
    
    <div class="better-sleep-content-{{ section.id }}">
      {% if section.settings.heading != blank %}
        <h2 class="heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <p class="description">{{ section.settings.description }}</p>
      {% endif %}
    </div>
  </div>

  <div class="better-sleep-cards-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="sleep-card-{{ section.id }}" {{ block.shopify_attributes }}>
        <div class="card-icon">{{ block.settings.icon }}</div>
        
        <h3 class="card-title">{{ block.settings.title }}</h3>
        
        <p class="card-description">{{ block.settings.description }}</p>
        
        {% if block.settings.link_text != blank and block.settings.link_url != blank %}
          <a href="{{ block.settings.link_url }}" class="card-link">
            {{ block.settings.link_text }}
            <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

