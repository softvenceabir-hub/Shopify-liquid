{% comment %}
  Section: Collection Mosaic Spotlight
  - Edge-to-edge slider with peek effect
  - Last card partially visible to indicate more content
  - Clean arrows on cards
  - Product thumbnails row
{% endcomment %}

{%- assign blocks_count = section.blocks.size -%}

{%- assign grid_cols_d = section.settings.cols_d | plus: 0 -%}
{%- if section.settings.auto_cols_d -%}
  {%- assign grid_cols_d = blocks_count -%}
  {%- if grid_cols_d < 2 -%}{%- assign grid_cols_d = 2 -%}{%- endif -%}
  {%- if grid_cols_d > 6 -%}{%- assign grid_cols_d = 6 -%}{%- endif -%}
{%- endif -%}

{%- assign grid_cols_m = section.settings.cols_m | plus: 0 -%}
{%- if section.settings.auto_cols_m -%}
  {%- assign grid_cols_m = blocks_count -%}
  {%- if grid_cols_m < 1 -%}{%- assign grid_cols_m = 1 -%}{%- endif -%}
  {%- if grid_cols_m > 2 -%}{%- assign grid_cols_m = 2 -%}{%- endif -%}
{%- endif -%}

{%- assign slides_d = section.settings.slides_d | plus: 0 -%}
{%- if section.settings.auto_slides_d -%}
  {%- assign slides_d = blocks_count -%}
  {%- if slides_d < 1 -%}{%- assign slides_d = 1 -%}{%- endif -%}
  {%- if slides_d > 6 -%}{%- assign slides_d = 6 -%}{%- endif -%}
{%- endif -%}

{%- assign slides_m = section.settings.slides_m | plus: 0 -%}
{%- if section.settings.auto_slides_m -%}
  {%- assign slides_m = blocks_count -%}
  {%- if slides_m < 1 -%}{%- assign slides_m = 1 -%}{%- endif -%}
  {%- if slides_m > 2 -%}{%- assign slides_m = 2 -%}{%- endif -%}
{%- endif -%}

{%- assign use_slider = false -%}
{%- if section.settings.layout_mode == 'slider' -%}{%- assign use_slider = true -%}{%- endif -%}

{%- assign card_text_align = section.settings.card_text_align -%}
{%- assign card_justify = 'flex-start' -%}
{%- if card_text_align == 'center' -%}{%- assign card_justify = 'center' -%}{%- endif -%}

<section id="cms-{{ section.id }}" class="cms-wrap" data-layout="{{ section.settings.layout_mode }}">
  <div class="cms-inner">
    {% if section.settings.show_head %}
      <header class="cms-head cms-align-{{ section.settings.head_align }}">
        {% if section.settings.kicker != blank %}
          <p class="cms-kicker">{{ section.settings.kicker }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="cms-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.sub != blank %}
          <p class="cms-sub">{{ section.settings.sub }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="cms-area {% if use_slider %}cms-area--slider{% else %}cms-area--grid{% endif %}">
      {% if use_slider and section.settings.slider_arrows %}
        <button type="button" class="cms-nav cms-prev" aria-label="Previous">‹</button>
        <button type="button" class="cms-nav cms-next" aria-label="Next">›</button>
      {% endif %}

      <div
        class="{% if use_slider %}cms-slider{% else %}cms-grid{% endif %}"
        role="list"
        {% if use_slider %}data-slider="true"{% endif %}
      >
        {% for block in section.blocks %}
          {% assign col = block.settings.collection %}

          <article class="cms-card" role="listitem" {{ block.shopify_attributes }}>
            {% if col != blank %}
              <a class="cms-link" href="{{ col.url }}">
                <div class="cms-media">
                  {% assign img = block.settings.image %}
                  {% if img == blank %}
                    {% assign img = col.featured_image %}
                  {% endif %}

                  {% if img != blank %}
                    <img
                      src="{{ img | image_url: width: 1600 }}"
                      alt="{{ col.title | escape }}"
                      loading="lazy"
                      width="{{ img.width }}"
                      height="{{ img.height }}"
                      class="cms-img"
                    >
                  {% else %}
                    <div class="cms-ph">
                      {{ 'collection-1' | placeholder_svg_tag: 'cms-phsvg' }}
                    </div>
                  {% endif %}

                  <div class="cms-overlay"></div>

                  <div class="cms-badge">
                    <span>
                      {% if block.settings.badge != blank %}
                        {{ block.settings.badge }}
                      {% else %}
                        Explore
                      {% endif %}
                    </span>
                  </div>
                </div>

                <div class="cms-body">
                  <h3 class="cms-ctitle">{{ col.title }}</h3>

                  <div class="cms-meta">
                    <span class="cms-count">{{ col.products_count }} items</span>
                    <span class="cms-arrow" aria-hidden="true">→</span>
                  </div>

                  {% if section.settings.show_prod and col.products_count > 0 %}
                    <div class="cms-prows" aria-label="Top products preview">
                      {% assign limit_n = section.settings.prod_limit %}
                      {% for p in col.products limit: limit_n %}
                        <span class="cms-p">
                          {% if p.featured_image %}
                            <img
                              src="{{ p.featured_image | image_url: width: 200 }}"
                              alt="{{ p.title | escape }}"
                              loading="lazy"
                              width="80"
                              height="80"
                              class="cms-pimg"
                            >
                          {% else %}
                            <span class="cms-psvg">
                              {{ 'product-1' | placeholder_svg_tag }}
                            </span>
                          {% endif %}
                        </span>
                      {% endfor %}
                      {% if col.products_count > limit_n %}
                        <span class="cms-more">+{{ col.products_count | minus: limit_n }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </a>
            {% else %}
              <div class="cms-empty">
                <div class="cms-empty-top">
                  {{ 'collection-1' | placeholder_svg_tag: 'cms-phsvg' }}
                </div>
                <div class="cms-empty-body">
                  <strong>Select a collection</strong>
                  <p>Block settings থেকে collection pick করো।</p>
                </div>
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if use_slider and section.settings.slider_dots %}
        <div class="cms-dots" aria-label="Slider pagination" data-dots></div>
      {% endif %}
    </div>

    {% if section.settings.show_btn and section.settings.btn_link != blank %}
      <div class="cms-cta">
        <a class="cms-btn" href="{{ section.settings.btn_link }}">{{ section.settings.btn_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #cms-{{ section.id }}{
    --padT: {{ section.settings.pad_t }}px;
    --padB: {{ section.settings.pad_b }}px;

    --containerW: {{ section.settings.container_w }}%;
    --headW: {{ section.settings.head_w }}%;

    --bg: {{ section.settings.bg }};
    --txt: {{ section.settings.txt }};
    --muted: {{ section.settings.muted }};
    --card: {{ section.settings.card }};
    --stroke: {{ section.settings.stroke }};
    --shadow: {{ section.settings.shadow }};
    --radius: {{ section.settings.radius }}px;

    --kicker: {{ section.settings.kicker_size }}px;
    --hsize: {{ section.settings.head_size }}px;
    --psize: {{ section.settings.sub_size }}px;

    --gap: {{ section.settings.gap }}px;

    --spv: {{ slides_d }};
    --spvM: {{ slides_m }};

    --sidePad: {{ section.settings.side_pad }}px;

    --cardAlign: {{ card_text_align }};
    background: var(--bg);
    color: var(--txt);
    padding: var(--padT) 0 var(--padB) 0;
  }

  #cms-{{ section.id }} .cms-inner{
    width: var(--containerW);
    margin: 0 auto;
    max-width: 100%;
  }

  #cms-{{ section.id }} .cms-head{
    margin-bottom: 20px;
    display: grid;
    gap: 6px;
    width: var(--headW);
    max-width: 920px;
    padding: 0 var(--sidePad);
  }

  #cms-{{ section.id }} .cms-align-left{ margin-left: 0; margin-right: auto; text-align: left; }
  #cms-{{ section.id }} .cms-align-center{ margin-left: auto; margin-right: auto; text-align: center; }

  #cms-{{ section.id }} .cms-kicker{
    margin: 0;
    font-size: var(--kicker);
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
  }
  #cms-{{ section.id }} .cms-title{ 
    margin: 0; 
    font-size: var(--hsize); 
    line-height: 1.15; 
    font-weight: 600;
    letter-spacing: .02em;
  }
  #cms-{{ section.id }} .cms-sub{ margin: 0; font-size: var(--psize); color: var(--muted); max-width: 70ch; }

  /* AREA - base */
  #cms-{{ section.id }} .cms-area{
    position: relative;
  }

  /* AREA - slider mode: contain overflow */
  #cms-{{ section.id }} .cms-area--slider{
    overflow: hidden;
  }

  /* GRID */
  #cms-{{ section.id }} .cms-grid{
    display: grid;
    gap: var(--gap);
    grid-template-columns: repeat({{ grid_cols_d }}, minmax(0, 1fr));
    align-items: stretch;
    padding: 0 var(--sidePad);
  }

  /* SLIDER - Edge to edge with peek effect */
  #cms-{{ section.id }} .cms-slider{
    display: flex;
    gap: var(--gap);
    padding-left: var(--sidePad);
    padding-right: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--sidePad);
    scrollbar-width: none;
  }
  #cms-{{ section.id }} .cms-slider::-webkit-scrollbar{ display:none; }

  /* Card sizing - shows partial last card for peek effect */
  #cms-{{ section.id }} .cms-area--slider .cms-card{
    flex: 0 0 calc((100% - var(--sidePad) - (var(--gap) * var(--spv))) / var(--spv));
    min-width: calc((100% - var(--sidePad) - (var(--gap) * var(--spv))) / var(--spv));
    scroll-snap-align: start;
  }

  /* Last card spacing */
  #cms-{{ section.id }} .cms-slider .cms-card:last-child{
    margin-right: var(--sidePad);
  }

  /* Navigation arrows - positioned on image area */
  #cms-{{ section.id }} .cms-nav{
    position: absolute;
    top: 28%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--stroke);
    background: rgba(255,255,255,.97);
    color: var(--txt);
    display: grid;
    place-items: center;
    cursor: pointer;
    font-size: 20px;
    box-shadow: 0 2px 10px rgba(0,0,0,.1);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  #cms-{{ section.id }} .cms-nav:hover{
    box-shadow: 0 4px 15px rgba(0,0,0,.15);
    transform: translateY(-50%) scale(1.05);
  }
  #cms-{{ section.id }} .cms-prev{ left: calc(var(--sidePad) + 6px); }
  #cms-{{ section.id }} .cms-next{ right: 6px; }

  #cms-{{ section.id }} .cms-dots{
    margin-top: 14px;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 0 var(--sidePad);
  }
  #cms-{{ section.id }} .cms-dot{
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid var(--stroke);
    background: rgba(0,0,0,.12);
    cursor: pointer;
    transition: background .2s ease;
  }
  #cms-{{ section.id }} .cms-dot.is-active{ background: var(--txt); }

  /* CARD */
  #cms-{{ section.id }} .cms-card{
    background: {% if section.settings.card_bg_off %}transparent{% else %}var(--card){% endif %};
    border: {% if section.settings.card_bg_off %}0{% else %}1px solid var(--stroke){% endif %};
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: {% if section.settings.card_bg_off %}none{% else %}0 4px 15px rgba(0,0,0, calc(var(--shadow) * 0.4)){% endif %};
    position: relative;
  }

  #cms-{{ section.id }} .cms-link{
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  #cms-{{ section.id }} .cms-media{
    position: relative;
    aspect-ratio: {{ section.settings.img_ratio_w }} / {{ section.settings.img_ratio_h }};
    overflow: hidden;
    border-radius: var(--radius);
  }

  #cms-{{ section.id }} .cms-img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease;
  }

  #cms-{{ section.id }} .cms-ph{
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    display: grid;
    place-items: center;
  }
  #cms-{{ section.id }} .cms-phsvg{
    width: 50%;
    height: 50%;
    opacity: .35;
  }

  #cms-{{ section.id }} .cms-overlay{
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.15) 100%);
    pointer-events: none;
  }

  #cms-{{ section.id }} .cms-badge{
    position: absolute;
    top: 10px;
    left: 10px;
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,.92);
    font-size: 12px;
    font-weight: 500;
    color: #333;
    box-shadow: 0 1px 4px rgba(0,0,0,.08);
  }

  #cms-{{ section.id }} .cms-body{
    padding: 12px 2px 6px;
    text-align: var(--cardAlign);
  }

  #cms-{{ section.id }} .cms-ctitle{ 
    margin: 0; 
    font-size: 15px; 
    font-weight: 500; 
    line-height: 1.3; 
    color: var(--txt);
  }

  #cms-{{ section.id }} .cms-meta{
    display: flex;
    justify-content: {{ card_justify }};
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 13px;
    margin-top: 2px;
  }

  #cms-{{ section.id }} .cms-prows{
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: {{ card_justify }};
    margin-top: 10px;
  }

  #cms-{{ section.id }} .cms-arrow{
    font-size: 14px;
    transform: translateX(0);
    transition: transform .25s ease;
  }

  #cms-{{ section.id }} .cms-p{
    width: 30px;
    height: 30px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--stroke);
    background: #fff;
    display: grid;
    place-items: center;
  }
  #cms-{{ section.id }} .cms-pimg{ width: 100%; height: 100%; object-fit: cover; display: block; }
  #cms-{{ section.id }} .cms-psvg svg{ width: 70%; height: 70%; opacity: .4; }
  #cms-{{ section.id }} .cms-more{ font-size: 11px; color: var(--muted); padding-left: 2px; }

  #cms-{{ section.id }} .cms-card:hover .cms-img{ transform: scale(1.05); }
  #cms-{{ section.id }} .cms-card:hover .cms-arrow{ transform: translateX(4px); }

  /* Empty state */
  #cms-{{ section.id }} .cms-empty{
    padding: 20px;
    text-align: center;
    background: #f9f9f9;
    border-radius: var(--radius);
  }
  #cms-{{ section.id }} .cms-empty-top{
    width: 100%;
    aspect-ratio: 4/5;
    background: #eee;
    border-radius: 8px;
    margin-bottom: 12px;
    display: grid;
    place-items: center;
  }
  #cms-{{ section.id }} .cms-empty-body p{
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  /* Mobile */
  @media (max-width: 989px){
    #cms-{{ section.id }}{
      --kicker: {{ section.settings.kicker_size_m }}px;
      --hsize: {{ section.settings.head_size_m }}px;
      --psize: {{ section.settings.sub_size_m }}px;

      --containerW: {{ section.settings.container_w_m }}%;
      --headW: {{ section.settings.head_w_m }}%;

      --spv: var(--spvM);
      --sidePad: 16px;
    }

    #cms-{{ section.id }} .cms-grid{
      grid-template-columns: repeat({{ grid_cols_m }}, minmax(0, 1fr));
    }

    #cms-{{ section.id }} .cms-area--slider .cms-card{
      flex: 0 0 calc((100% - var(--sidePad) - (var(--gap) * var(--spv))) / var(--spv));
      min-width: calc((100% - var(--sidePad) - (var(--gap) * var(--spv))) / var(--spv));
    }

    #cms-{{ section.id }} .cms-nav{
      width: 34px;
      height: 34px;
      font-size: 16px;
      top: 30%;
    }
    #cms-{{ section.id }} .cms-prev{ left: 8px; }
    #cms-{{ section.id }} .cms-next{ right: 8px; }

    #cms-{{ section.id }} .cms-ctitle{ font-size: 13px; }
    #cms-{{ section.id }} .cms-meta{ font-size: 11px; }
    #cms-{{ section.id }} .cms-p{ width: 26px; height: 26px; border-radius: 6px; }
    #cms-{{ section.id }} .cms-badge{ font-size: 11px; padding: 4px 10px; }
  }

  /* CTA */
  #cms-{{ section.id }} .cms-cta{
    margin-top: 20px;
    display: flex;
    justify-content: center;
    padding: 0 var(--sidePad);
  }
  #cms-{{ section.id }} .cms-btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: 999px;
    border: 1px solid var(--txt);
    background: var(--txt);
    color: var(--bg);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: transform .2s ease, opacity .2s ease;
  }
  #cms-{{ section.id }} .cms-btn:hover{ transform: translateY(-2px); opacity: .9; }
</style>

<script>
  (function(){
    var root = document.getElementById('cms-{{ section.id }}');
    if(!root) return;

    var layout = root.getAttribute('data-layout');
    if(layout !== 'slider') return;

    var track = root.querySelector('.cms-slider');
    if(!track) return;

    var prev = root.querySelector('.cms-prev');
    var next = root.querySelector('.cms-next');
    var dotsWrap = root.querySelector('[data-dots]');

    function getGap(){
      var styles = getComputedStyle(track);
      return parseFloat(styles.gap || styles.columnGap || 0) || 0;
    }

    function getStep(){
      var card = track.querySelector('.cms-card');
      if(!card) return track.clientWidth;
      return card.getBoundingClientRect().width + getGap();
    }

    function scrollByDir(dir){
      track.scrollBy({ left: dir * getStep(), behavior: 'smooth' });
    }

    if(prev) prev.addEventListener('click', function(){ scrollByDir(-1); });
    if(next) next.addEventListener('click', function(){ scrollByDir(1); });

    function buildDots(){
      if(!dotsWrap) return;
      dotsWrap.innerHTML = '';

      var cards = track.querySelectorAll('.cms-card');
      if(!cards.length) return;

      var step = getStep();
      var pages = Math.max(1, Math.round((track.scrollWidth - track.clientWidth) / step) + 1);

      for(var i=0;i<pages;i++){
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'cms-dot' + (i===0 ? ' is-active' : '');
        b.setAttribute('aria-label', 'Go to slide ' + (i+1));
        (function(index){
          b.addEventListener('click', function(){
            track.scrollTo({ left: index * step, behavior: 'smooth' });
          });
        })(i);
        dotsWrap.appendChild(b);
      }
    }

    function syncDots(){
      if(!dotsWrap) return;
      var dots = dotsWrap.querySelectorAll('.cms-dot');
      if(!dots.length) return;

      var step = getStep();
      var index = Math.round(track.scrollLeft / step);
      if(index < 0) index = 0;
      if(index >= dots.length) index = dots.length - 1;

      dots.forEach(function(d){ d.classList.remove('is-active'); });
      dots[index].classList.add('is-active');
    }

    function toggleNav(){
      var hasOverflow = track.scrollWidth > (track.clientWidth + 5);
      if(prev) prev.style.display = hasOverflow ? '' : 'none';
      if(next) next.style.display = hasOverflow ? '' : 'none';
      if(dotsWrap) dotsWrap.style.display = hasOverflow ? '' : 'none';
    }

    buildDots();
    syncDots();
    toggleNav();

    track.addEventListener('scroll', function(){ window.requestAnimationFrame(syncDots); });
    window.addEventListener('resize', function(){
      buildDots();
      syncDots();
      toggleNav();
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Mosaic",
  "settings": [
    { "type": "checkbox", "id": "show_head", "label": "Show heading", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker (small top text)", "default": "EXPLORE" },
    { "type": "text", "id": "title", "label": "Heading", "default": "SHOP BY COLLECTION" },
    { "type": "textarea", "id": "sub", "label": "Subheading" },

    { "type": "select", "id": "layout_mode", "label": "Layout mode", "default": "slider",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ]
    },

    { "type": "select", "id": "head_align", "label": "Title alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "range", "id": "container_w", "label": "Container width desktop (%)", "min": 60, "max": 100, "step": 5, "default": 100 },
    { "type": "range", "id": "container_w_m", "label": "Container width mobile (%)", "min": 80, "max": 100, "step": 5, "default": 100 },

    { "type": "range", "id": "head_w", "label": "Title block width desktop (%)", "min": 40, "max": 100, "step": 5, "default": 80 },
    { "type": "range", "id": "head_w_m", "label": "Title block width mobile (%)", "min": 70, "max": 100, "step": 5, "default": 100 },

    { "type": "select", "id": "card_text_align", "label": "Card content alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },

    { "type": "range", "id": "side_pad", "label": "Side padding (px)", "min": 0, "max": 60, "step": 2, "default": 20 },
    { "type": "range", "id": "pad_t", "label": "Padding top (px)", "min": 0, "max": 120, "step": 4, "default": 32 },
    { "type": "range", "id": "pad_b", "label": "Padding bottom (px)", "min": 0, "max": 120, "step": 4, "default": 32 },

    { "type": "range", "id": "gap", "label": "Gap (px)", "min": 8, "max": 40, "step": 2, "default": 14 },

    { "type": "range", "id": "img_ratio_w", "label": "Image ratio width", "min": 1, "max": 16, "step": 1, "default": 4 },
    { "type": "range", "id": "img_ratio_h", "label": "Image ratio height", "min": 1, "max": 16, "step": 1, "default": 5 },

    { "type": "checkbox", "id": "auto_cols_d", "label": "Grid: auto desktop per row (match blocks)", "default": true },
    { "type": "select", "id": "cols_d", "label": "Grid: desktop cards per row", "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },

