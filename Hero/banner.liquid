{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-progress-slider-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.section_width }}%;
    max-width: {{ block.settings.section_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_y }}px {{ block.settings.section_padding_x }}px;
  }

  .ai-slider-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .ai-slider-content-{{ ai_gen_id }}:active {
    cursor: grabbing;
  }

  @media (min-width: 768px) {
    .ai-slider-content-{{ ai_gen_id }} {
      touch-action: auto;
      cursor: default;
    }
  }

  .ai-slider-wrapper-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    position: relative;
  }

  .ai-slider-wrapper-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-slider-image-{{ ai_gen_id }} {
    width: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-slider-video-{{ ai_gen_id }} {
    width: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-slider-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  /* Mobile: Show only mobile image/video */
  .ai-slider-image-desktop-{{ ai_gen_id }},
  .ai-slider-video-desktop-{{ ai_gen_id }} {
    display: none !important;
  }

  .ai-slider-image-mobile-{{ ai_gen_id }},
  .ai-slider-video-mobile-{{ ai_gen_id }} {
    display: block !important;
    height: {{ block.settings.image_height_mobile }}px;
  }

  /* Desktop: Show only desktop image/video */
  @media (min-width: 768px) {
    .ai-slider-image-desktop-{{ ai_gen_id }},
    .ai-slider-video-desktop-{{ ai_gen_id }} {
      display: block !important;
      height: {{ block.settings.image_height_desktop }}px;
    }

    .ai-slider-image-mobile-{{ ai_gen_id }},
    .ai-slider-video-mobile-{{ ai_gen_id }} {
      display: none !important;
    }
  }

  .ai-slider-btn-group-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.controls_offset }}px;
    left: 50%;
    transform: translateX(-50%);
    width: 95%;
    height: fit-content;
    color: {{ block.settings.controls_text_color }};
    background-color: {{ block.settings.controls_bg_color }};
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
    display: none;
    border-radius: {{ block.settings.controls_border_radius }}px;
    z-index: 10;
  }

  @media (min-width: 768px) {
    .ai-slider-btn-group-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat({{ block.settings.slides_count }}, 1fr);
    }
  }

  .ai-slider-btn-{{ ai_gen_id }} {
    text-align: left;
    padding: 12px;
    border-right: 1px solid {{ block.settings.controls_border_color }};
    position: relative;
    cursor: pointer;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .ai-slider-btn-{{ ai_gen_id }}:last-child {
    border-right: none;
  }

  .ai-slider-btn-{{ ai_gen_id }}:hover {
    color: {{ block.settings.controls_hover_text_color }};
  }

  .ai-slider-btn-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.controls_title_size }}px;
    font-weight: 600;
    margin-bottom: 4px;
    position: relative;
    z-index: 2;
  }

  .ai-slider-btn-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.controls_subtitle_size }}px;
    opacity: 0.8;
    position: relative;
    z-index: 2;
    margin-bottom: 8px;
  }

  .ai-slider-shop-btn-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.shop_btn_padding_y }}px {{ block.settings.shop_btn_padding_x }}px;
    background-color: {{ block.settings.shop_btn_bg_color }};
    color: {{ block.settings.shop_btn_text_color }};
    font-size: {{ block.settings.shop_btn_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.shop_btn_border_radius }}px;
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
    border: {{ block.settings.shop_btn_border_width }}px solid {{ block.settings.shop_btn_border_color }};
  }

  .ai-slider-shop-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.shop_btn_hover_bg_color }};
    color: {{ block.settings.shop_btn_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-slider-progress-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 100%;
    background-color: {{ block.settings.progress_color }};
    width: 0%;
    transition: width {{ block.settings.slide_duration }}s linear;
    z-index: 1;
  }

  .ai-slider-btn-{{ ai_gen_id }}.active .ai-slider-progress-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-slider-btn-{{ ai_gen_id }}.paused .ai-slider-progress-{{ ai_gen_id }} {
    transition: none;
  }

  /* Mobile slide indicators (dots) */
  .ai-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  @media (min-width: 768px) {
    .ai-slider-dots-{{ ai_gen_id }} {
      display: none;
    }
  }

  .ai-slider-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .ai-slider-dot-{{ ai_gen_id }}.active {
    background-color: rgba(0, 0, 0, 0.8);
    width: 24px;
    border-radius: 4px;
  }

  /* Mobile slide info overlay */
  .ai-mobile-slide-info-{{ ai_gen_id }} {
    display: block;
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background-color: {{ block.settings.mobile_info_bg_color }};
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 16px;
    border-radius: {{ block.settings.mobile_info_border_radius }}px;
    z-index: 5;
  }

  @media (min-width: 768px) {
    .ai-mobile-slide-info-{{ ai_gen_id }} {
      display: none;
    }
  }

  .ai-mobile-slide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.mobile_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.mobile_text_color }};
    margin-bottom: 4px;
  }

  .ai-mobile-slide-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.mobile_subtitle_size }}px;
    color: {{ block.settings.mobile_text_color }};
    opacity: 0.9;
    margin-bottom: 12px;
  }

  .ai-mobile-shop-btn-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.mobile_btn_padding_y }}px {{ block.settings.mobile_btn_padding_x }}px;
    background-color: {{ block.settings.mobile_btn_bg_color }};
    color: {{ block.settings.mobile_btn_text_color }};
    font-size: {{ block.settings.mobile_btn_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.mobile_btn_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.mobile_btn_border_width }}px solid {{ block.settings.mobile_btn_border_color }};
  }

  .ai-mobile-shop-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.mobile_btn_hover_bg_color }};
    color: {{ block.settings.mobile_btn_hover_text_color }};
    transform: translateY(-2px);
  }
{% endstyle %}

<progress-slider-{{ ai_gen_id }} class="ai-progress-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-slider-content-{{ ai_gen_id }}">
    {% for i in (1..block.settings.slides_count) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
        assign video_key = 'slide_' | append: i | append: '_video'
        assign mobile_video_key = 'slide_' | append: i | append: '_mobile_video'
        assign media_type_key = 'slide_' | append: i | append: '_media_type'
        assign title_key = 'slide_' | append: i | append: '_title'
        assign subtitle_key = 'slide_' | append: i | append: '_subtitle'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_url_key = 'slide_' | append: i | append: '_button_url'
        assign show_button_key = 'slide_' | append: i | append: '_show_button'
        
        assign slide_image = block.settings[image_key]
        assign mobile_image = block.settings[mobile_image_key]
        assign slide_video = block.settings[video_key]
        assign mobile_video = block.settings[mobile_video_key]
        assign media_type = block.settings[media_type_key]
        assign slide_title = block.settings[title_key]
        assign slide_subtitle = block.settings[subtitle_key]
        assign button_text = block.settings[button_text_key]
        assign button_url = block.settings[button_url_key]
        assign show_button = block.settings[show_button_key]
      %}
      <div class="ai-slider-wrapper-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide="{{ i }}">
        
        {% if media_type == 'video' %}
          {%- comment -%} Video Content {%- endcomment -%}
          {% if slide_video %}
            <video
              src="{{ slide_video }}"
              autoplay
              muted
              loop
              playsinline
              class="ai-slider-video-{{ ai_gen_id }} ai-slider-video-desktop-{{ ai_gen_id }}"
            ></video>
          {% endif %}

          {% if mobile_video %}
            <video
              src="{{ mobile_video }}"
              autoplay
              muted
              loop
              playsinline
              class="ai-slider-video-{{ ai_gen_id }} ai-slider-video-mobile-{{ ai_gen_id }}"
            ></video>
          {% elsif slide_video %}
            <video
              src="{{ slide_video }}"
              autoplay
              muted
              loop
              playsinline
              class="ai-slider-video-{{ ai_gen_id }} ai-slider-video-mobile-{{ ai_gen_id }}"
            ></video>
          {% endif %}

        {% else %}
          {%- comment -%} Image Content {%- endcomment -%}
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="lazy"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="ai-slider-image-{{ ai_gen_id }} ai-slider-image-desktop-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slider-image-placeholder-{{ ai_gen_id }} ai-slider-image-desktop-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if mobile_image %}
            <img
              src="{{ mobile_image | image_url: width: 1200 }}"
              alt="{{ mobile_image.alt | escape }}"
              loading="lazy"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
              class="ai-slider-image-{{ ai_gen_id }} ai-slider-image-mobile-{{ ai_gen_id }}"
            >
          {% elsif slide_image %}
            <img
              src="{{ slide_image | image_url: width: 1200 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="lazy"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="ai-slider-image-{{ ai_gen_id }} ai-slider-image-mobile-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slider-image-placeholder-{{ ai_gen_id }} ai-slider-image-mobile-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% endif %}

        <div class="ai-mobile-slide-info-{{ ai_gen_id }}">
          <div class="ai-mobile-slide-title-{{ ai_gen_id }}">{{ slide_title }}</div>
          <div class="ai-mobile-slide-subtitle-{{ ai_gen_id }}">{{ slide_subtitle }}</div>
          
          {% if show_button and button_text != blank %}
            <a href="{{ button_url | default: '#' }}" class="ai-mobile-shop-btn-{{ ai_gen_id }}">
              {{ button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}

    <div class="ai-slider-btn-group-{{ ai_gen_id }}">
      {% for i in (1..block.settings.slides_count) %}
        {% liquid
          assign title_key = 'slide_' | append: i | append: '_title'
          assign subtitle_key = 'slide_' | append: i | append: '_subtitle'
          assign button_text_key = 'slide_' | append: i | append: '_button_text'
          assign button_url_key = 'slide_' | append: i | append: '_button_url'
          assign show_button_key = 'slide_' | append: i | append: '_show_button'
          
          assign slide_title = block.settings[title_key]
          assign slide_subtitle = block.settings[subtitle_key]
          assign button_text = block.settings[button_text_key]
          assign button_url = block.settings[button_url_key]
          assign show_button = block.settings[show_button_key]
        %}
        <div class="ai-slider-btn-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide="{{ i }}">
          <div class="ai-slider-btn-title-{{ ai_gen_id }}">{{ slide_title }}</div>
          <div class="ai-slider-btn-subtitle-{{ ai_gen_id }}">{{ slide_subtitle }}</div>
          
          {% if show_button and button_text != blank %}
            <a href="{{ button_url | default: '#' }}" class="ai-slider-shop-btn-{{ ai_gen_id }}">
              {{ button_text }}
            </a>
          {% endif %}
          
          <div class="ai-slider-progress-{{ ai_gen_id }}"></div>
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Mobile dots indicator -->
  <div class="ai-slider-dots-{{ ai_gen_id }}">
    {% for i in (1..block.settings.slides_count) %}
      <div class="ai-slider-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-slide="{{ i }}"></div>
    {% endfor %}
  </div>
</progress-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ProgressSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = {{ block.settings.slides_count }};
        this.duration = {{ block.settings.slide_duration }} * 1000;
        this.autoplay = {{ block.settings.enable_autoplay }};
        this.timer = null;
        this.isPaused = false;
        this.touchStartX = 0;
        this.touchEndX = 0;
        this.isMobile = window.innerWidth < 768;
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-slider-btn-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-slider-wrapper-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slider-dot-{{ ai_gen_id }}');
        this.sliderContent = this.querySelector('.ai-slider-content-{{ ai_gen_id }}');
        
        this.setupEventListeners();
        this.setupTouchEvents();
        
        if (this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => {
          this.isMobile = window.innerWidth < 768;
        });
      }

      setupEventListeners() {
        this.buttons.forEach((button, index) => {
          button.addEventListener('click', (e) => {
            if (!e.target.classList.contains('ai-slider-shop-btn-{{ ai_gen_id }}')) {
              this.goToSlide(index + 1);
            }
          });

          button.addEventListener('mouseenter', () => {
            if (this.autoplay && !this.isMobile) {
              this.pauseAutoplay();
            }
          });

          button.addEventListener('mouseleave', () => {
            if (this.autoplay && !this.isMobile) {
              this.resumeAutoplay();
            }
          });
        });

        // Dot click events for mobile
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index + 1);
          });
        });
      }

      setupTouchEvents() {
        this.sliderContent.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
        });

        this.sliderContent.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        });

        // Mouse drag for mobile view
        this.sliderContent.addEventListener('mousedown', (e) => {
          if (this.isMobile) {
            this.touchStartX = e.screenX;
          }
        });

        this.sliderContent.addEventListener('mouseup', (e) => {
          if (this.isMobile) {
            this.touchEndX = e.screenX;
            this.handleSwipe();
          }
        });
      }

      handleSwipe() {
        const swipeThreshold = 50;
        const difference = this.touchStartX - this.touchEndX;

        if (Math.abs(difference) > swipeThreshold) {
          if (difference > 0) {
            this.nextSlide();
          } else {
            this.previousSlide();
          }
        }
      }

      goToSlide(slideNumber) {
        if (slideNumber === this.currentSlide) return;

        this.buttons.forEach(btn => {
          btn.classList.remove('active');
          btn.classList.remove('paused');
        });
        
        this.slides.forEach(slide => {
          slide.classList.remove('active');
        });

        this.dots.forEach(dot => {
          dot.classList.remove('active');
        });

        this.currentSlide = slideNumber;
        
        this.buttons[slideNumber - 1].classList.add('active');
        this.slides[slideNumber - 1].classList.add('active');
        this.dots[slideNumber - 1].classList.add('active');

        if (this.autoplay && !this.isPaused) {
          this.resetAutoplay();
        }
      }

      startAutoplay() {
        this.timer = setTimeout(() => {
          this.nextSlide();
        }, this.duration);
      }

      resetAutoplay() {
        clearTimeout(this.timer);
        this.startAutoplay();
      }

      pauseAutoplay() {
        this.isPaused = true;
        clearTimeout(this.timer);
        this.buttons[this.currentSlide - 1].classList.add('paused');
      }

      resumeAutoplay() {
        this.isPaused = false;
        this.buttons[this.currentSlide - 1].classList.remove('paused');
        this.resetAutoplay();
      }

      nextSlide() {
        const nextSlideNumber = this.currentSlide === this.totalSlides ? 1 : this.currentSlide + 1;
        this.goToSlide(nextSlideNumber);
      }

      previousSlide() {
        const prevSlideNumber = this.currentSlide === 1 ? this.totalSlides : this.currentSlide - 1;
        this.goToSlide(prevSlideNumber);
      }

      disconnectedCallback() {
        clearTimeout(this.timer);
      }
    }

    customElements.define('progress-slider-{{ ai_gen_id }}', ProgressSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
